<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.7.2</Version>
    <AssemblyVersion>1.7.2.0</AssemblyVersion>
    <FileVersion>1.7.2.0</FileVersion>
    <InformationalVersion>1.7.2</InformationalVersion>
    <Description>AstroCast CLI — Console chart calculator</Description>
    <!--
      The Windows application manifest: UTF-8 as the process's code page, so the
      ephemeris folder's path reaches the Swiss Ephemeris library whole whatever
      letters it holds (branch EphePath, 1.7.2; finding N4). See app.manifest.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstroCast.Core\AstroCast.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

</Project>
