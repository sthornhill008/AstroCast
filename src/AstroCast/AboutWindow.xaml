<Window x:Class="AstroCast.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AstroCast"
        Width="600" Height="560"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/AstroCast.ico">

    <!--
        The About window: the AGPL's "Appropriate Legal Notices" (section 0,
        required by section 5(d)). Its DataContext is an AboutViewModel, the
        same one the Avalonia head's AboutWindow shows. Close is IsCancel, so in
        this modal window a click on it, or Escape, closes the window.
    -->
    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding VersionLine}"
                       FontSize="18"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding CopyrightLine}"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding Notice}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Margin="0,12,0,0" />
            <!-- A read-only, borderless TextBox, so the source line can be selected and copied. -->
            <TextBox Text="{Binding SourceLine, Mode=OneWay}"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,12,0,8">
                <Button Content="Licence"
                        Command="{Binding ShowLicenceCommand}"
                        Padding="12,5"
                        MinWidth="100" />
                <Button Content="Third-party notices"
                        Command="{Binding ShowNoticesCommand}"
                        Padding="12,5"
                        MinWidth="100"
                        Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <Button DockPanel.Dock="Bottom"
                Content="Close"
                IsCancel="True"
                MinWidth="88"
                Padding="12,5"
                HorizontalAlignment="Right"
                Margin="0,12,0,0" />

        <TextBox Text="{Binding DisplayedText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 AutomationProperties.Name="Licence or third-party notices" />

    </DockPanel>
</Window>
