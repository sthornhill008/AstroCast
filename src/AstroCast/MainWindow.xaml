<Window x:Class="AstroCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstroCast"
        xmlns:conv="clr-namespace:AstroCast.Converters"
        xmlns:enums="clr-namespace:AstroCast.Core.Enums;assembly=AstroCast.Core"
        xmlns:vm="clr-namespace:AstroCast.ViewModels;assembly=AstroCast.Presentation"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/AstroCast.ico"
        Height="600" Width="950"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Gesture="Alt+1" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Chart}" />
        <KeyBinding Gesture="Alt+2" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Synastry}" />
        <KeyBinding Gesture="Alt+3" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Transits}" />
        <KeyBinding Gesture="Alt+4" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Returns}" />
        <KeyBinding Gesture="Alt+5" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Electional}" />
        <KeyBinding Gesture="Alt+6" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Medical}" />
        <KeyBinding Gesture="Alt+7" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Export}" />
        <KeyBinding Gesture="Alt+8" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Map}" />
        <KeyBinding Gesture="Alt+9" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Relocation}" />
        <!-- Directions, the tenth panel (1.5.0, branch PrimaryPanel): Alt+0, the last free digit -->
        <KeyBinding Gesture="Alt+0" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Directions}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVisConverter" />
        <conv:DisplayTextConverter x:Key="DisplayTextConverter" />

        <!--
            The screen's names for enums (1.4.0, E3-6): the name-bearing
            ComboBoxes' item template, which WPF also uses for the closed box,
            so SelectedItem stays the enum.
        -->
        <DataTemplate x:Key="DisplayTextItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource DisplayTextConverter}}" />
        </DataTemplate>

        <!-- Shared label style for form labels -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF333333" />
        </Style>

        <!-- Shared style for form text boxes -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Shared style for action buttons -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinWidth" Value="100" />
        </Style>

        <!-- Style for export buttons -->
        <Style x:Key="ExportButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FF4A90D9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#FF3A7BC8" />
        </Style>

        <!-- Style for section headers -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF4A90D9" />
            <Setter Property="Margin" Value="0,8,0,6" />
        </Style>

        <!-- Sidebar navigation button style. Padding 4,5 and each caption's top margin 1 since 1.5.0
             (branch PrimaryPanel, scoping decision 2a), 4,8 and 2 until then, so ten buttons fit. -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFAABBCC" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF253D54" />
                                <Setter Property="Foreground" Value="#FFDDEEFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasActiveOperation,
                                Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding ActiveOperationDisplayName, StringFormat='Active: {0}'}"
                               Margin="12,0,0,0"
                               Foreground="#FF4A90D9"
                               FontStyle="Italic"
                               VerticalAlignment="Center" />
                    <Button Content="Cancel All"
                            Command="{Binding CancelCommand}"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            ToolTip="Cancel every active calculation" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}"
                               Foreground="#FF888888"
                               VerticalAlignment="Center" />
                    <Button Content="About"
                            Command="{Binding OpenAboutWindowCommand}"
                            AutomationProperties.Name="About AstroCast"
                            ToolTip="Version, licence and third-party notices"
                            Padding="8,2"
                            Margin="8,0,0,0" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="360" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════════════ -->
            <!-- SIDEBAR: Navigation Icon Rail           -->
            <!-- ════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="#FF1B2838"
                    Padding="0,8">
                <StackPanel>
                    <!-- Chart -->
                    <Button Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Chart}"
                            ToolTip="Natal Chart Input (Alt+1)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePanel}" Value="Chart">
                                        <Setter Property="Background" Value="#FF253D54" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4A90D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="&#x2609;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Chart" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Synastry -->
                    <Button Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Synastry}"
                            ToolTip="Synastry &amp; Composite (Alt+2)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePanel}" Value="Synastry">
                                        <Setter Property="Background" Value="#FF253D54" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4A90D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="&#x260C;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Synastry" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Transits -->
                    <Button Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Transits}"
                            ToolTip="Transits &amp; Progressions (Alt+3)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePanel}" Value="Transits">
                                        <Setter Property="Background" Value="#FF253D54" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4A90D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="&#x21BB;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Transits" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Returns -->
                    <Button Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Returns}"
                            ToolTip="Solar &amp; Lunar Returns (Alt+4)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePanel}" Value="Returns">
                                        <Setter Property="Background" Value="#FF253D54" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4A90D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="&#x2600;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Returns" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Relocation -->
                    <Button Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Relocation}"
                            ToolTip="Relocation Chart (Alt+9)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePanel}" Value="Relocation">
                                        <Setter Property="Background" Value="#FF253D54" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4A90D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="&#x1F9ED;" FontSize="20" HorizontalAlignment="Center"
                                       FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="Relocate" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Directions (1.5.0, branch PrimaryPanel) -->
                    <Button Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Directions}"
                            ToolTip="Primary Directions (Alt+0)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePanel}" Value="Directions">
                                        <Setter Property="Background" Value="#FF253D54" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4A90D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="&#x2192;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Primary" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Electional -->
                    <Button Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Electional}"
                            ToolTip="Electional Astrology (Alt+5)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePanel}" Value="Electional">
                                        <Setter Property="Background" Value="#FF253D54" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4A90D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="&#x2605;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Election" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Medical -->
                    <Button Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Medical}"
                            ToolTip="Medical Astrology (Alt+6)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePanel}" Value="Medical">
                                        <Setter Property="Background" Value="#FF253D54" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4A90D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="&#x2695;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Medical" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Map (Astrocartography) -->
                    <Button Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Map}"
                            ToolTip="Astrocartography Map (Alt+8)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePanel}" Value="Map">
                                        <Setter Property="Background" Value="#FF253D54" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4A90D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="&#x1F30D;" FontSize="20" HorizontalAlignment="Center"
                                       FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="Map" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Export -->
                    <Button Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Export}"
                            ToolTip="Export &amp; Backup (Alt+7)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePanel}" Value="Export">
                                        <Setter Property="Background" Value="#FF253D54" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4A90D9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="&#x2913;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Export" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════ -->
            <!-- CONTENT PANEL: Switchable panels         -->
            <!-- ════════════════════════════════════════ -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="10,0,0,0"
                          Padding="0,0,8,0">
                <StackPanel>

                    <!-- ═══ CHART PANEL ═══ -->
                    <StackPanel Visibility="{Binding IsChartPanelVisible,
                                Converter={StaticResource BoolToVisConverter}}">

                        <!-- Panel Header -->
                        <TextBlock Text="Natal Chart"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF1B4F72"
                                   Margin="0,0,0,8" />

                        <!-- Chart Subject -->
                        <TextBlock Text="Chart Subject" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding ChartEntry.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Type"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding EventTypes}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding ChartEntry.EventType}"
                                      Margin="0,2" Padding="4,3" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Gender"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{Binding GenderValues}"
                                      SelectedItem="{Binding ChartEntry.Gender}"
                                      Margin="0,2" Padding="4,3" />
                        </Grid>

                        <!-- Location -->
                        <TextBlock Text="Location" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Location Lookup -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Lookup"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding ChartEntryLocationSearch.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Enter city name to search (e.g., Richmond, VA)" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="Lookup"
                                    Command="{Binding LookupLocationCommand}"
                                    Padding="8,3"
                                    Margin="4,2,0,2" />

                            <!-- Row 1: Results Dropdown -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Results"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding ChartEntryLocationSearch.Results}"
                                      SelectedItem="{Binding ChartEntryLocationSearch.SelectedResult}"
                                      IsDropDownOpen="{Binding ChartEntryLocationSearch.IsDropDownOpen, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="Select a result to fill in coordinates and timezone" />

                            <!-- Row 2: Latitude -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Latitude"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding ChartEntry.LatitudeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Decimal degrees (positive = North)" />

                            <!-- Row 3: Longitude -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Longitude"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding ChartEntry.LongitudeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Decimal degrees (positive = East)" />

                            <!-- Row 4: Location Name -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Location"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding ChartEntry.LocationName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="City, State/Country" />
                        </Grid>

                        <!-- Date, Time & Timezone -->
                        <TextBlock Text="Date, Time &amp; Timezone" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Date"
                                       Style="{StaticResource FormLabel}" />
                            <DockPanel Grid.Row="0" Grid.Column="1">
                                <Button DockPanel.Dock="Right"
                                        Content="Now"
                                        Command="{Binding NowCommand}"
                                        Width="40" Margin="5,2,0,2"
                                        VerticalAlignment="Center"
                                        ToolTip="Set date and time to now" />
                                <DatePicker SelectedDate="{Binding ChartEntry.EventDate}"
                                            Margin="0,2" Padding="4,3" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Time"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding ChartEntry.EventTime, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="HH:mm:ss (24-hour format)" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Timezone"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{Binding FilteredTimezones}"
                                      SelectedItem="{Binding ChartEntry.SelectedTimezone}"
                                      Text="{Binding ChartEntry.TimeZone, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      Margin="0,2" Padding="4,3"
                                      MaxDropDownHeight="300"
                                      ToolTip="IANA timezone ID (e.g., America/New_York)">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChartEntry.IsTimezoneValid}" Value="False">
                                                <Setter Property="BorderBrush" Value="Red" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="ToolTip" Value="Unrecognized timezone. Select from the list or type a valid IANA timezone ID." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <!-- Resolved UTC offset display (read-only, auto-computed) -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Offset"
                                       Style="{StaticResource FormLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding ChartEntry.ResolvedOffsetDisplay, Mode=OneWay}"
                                       Margin="0,4" Padding="4,3"
                                       FontWeight="SemiBold"
                                       Foreground="#1B4F72"
                                       ToolTip="The UTC offset that will be applied for this timezone and date. Verify this is correct — for historical charts (pre-1966), the IANA timezone database may apply the wrong DST rule." />

                            <!-- Explicit UTC offset override (for historical charts) -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Override"
                                       Style="{StaticResource FormLabel}" />
                            <CheckBox Grid.Row="4" Grid.Column="1"
                                      IsChecked="{Binding ChartEntry.UseExplicitOffset}"
                                      Content="Use explicit UTC offset (historical charts)"
                                      Margin="0,4"
                                      ToolTip="Check this for pre-1966 dates where DST status is known from the birth record" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="UTC Offset"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Text="{Binding ChartEntry.UtcOffsetHoursText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     IsEnabled="{Binding ChartEntry.UseExplicitOffset}"
                                     ToolTip="UTC offset in hours (e.g., -5 for EST, -4 for EDT, 1 for CET)" />
                        </Grid>

                        <!-- Houses -->
                        <TextBlock Text="Houses" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="System"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding ChartEntry.AvailableHouseSystems}"
                                      SelectedItem="{Binding ChartEntry.SelectedHouseSystem}"
                                      ItemTemplate="{StaticResource DisplayTextItemTemplate}"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="House system for chart calculation. Placidus is the default. Use Equal or Whole Sign for unknown birth times or extreme latitudes." />

                            <!-- Row 1: the session's minor-points switch (1.6.0, branch AsteroidsPanel). Ticking or
                                 unticking it recasts the Chart panel's chart; it is never saved with the chart. -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Points"
                                       Style="{StaticResource FormLabel}" />
                            <CheckBox Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding ChartEntry.IncludeMinorPoints}"
                                      Content="Include asteroids and Lilith"
                                      Margin="0,4"
                                      ToolTip="Ceres, Pallas, Juno, Vesta and Black Moon Lilith (the mean apogee) in every report that carries them this session; not saved with the chart." />
                        </Grid>

                        <!-- Notes -->
                        <TextBlock Text="Notes" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding ChartEntry.SourceNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Data source (e.g., birth certificate, from memory)" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Notes"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding ChartEntry.Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="50"
                                     VerticalScrollBarVisibility="Auto" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Keywords"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding ChartEntry.Keywords, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Comma-separated keywords for categorisation (e.g., celebrity, politician, family)" />
                        </Grid>

                        <!-- Horary Question (visible only when EventType is Horary) -->
                        <StackPanel Visibility="{Binding ChartEntry.IsHorary,
                                    Converter={StaticResource BoolToVisConverter}}">

                            <TextBlock Text="Horary Question"
                                       Style="{StaticResource SectionHeader}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Category -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Category"
                                           Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding ChartEntry.AvailableHoraryCategories}"
                                          SelectedItem="{Binding ChartEntry.HoraryCategory}"
                                          Margin="0,2" Padding="4,3"
                                          ToolTip="Select the question category to determine which house governs the quesited matter" />

                                <!-- Row 1: Question -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Question"
                                           Style="{StaticResource FormLabel}"
                                           VerticalAlignment="Top"
                                           Margin="0,6,8,0" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding ChartEntry.HoraryQuestion, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="60"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="The horary question. First line is the question; additional lines provide context." />

                                <!-- Row 2: Set to Now button -->
                                <Button Grid.Row="2" Grid.Column="1"
                                        Content="Set to Now"
                                        Command="{Binding SetToNowCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0"
                                        Padding="10,3"
                                        ToolTip="Set the date and time to right now (horary charts use the moment of the question)" />
                            </Grid>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <TextBlock Text="Actions" Style="{StaticResource SectionHeader}" />

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Calculate &amp; Save"
                                    Command="{Binding CalculateAndSaveCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Save Markdown"
                                    Command="{Binding ExportMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Export the currently calculated chart as a Markdown file" />
                            <Button Content="Clear"
                                    Command="{Binding ClearFormCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                    </StackPanel>

                    <!-- ═══ SYNASTRY PANEL ═══ -->
                    <StackPanel Visibility="{Binding IsSynastryPanelVisible,
                                Converter={StaticResource BoolToVisConverter}}">

                        <!-- Panel Header -->
                        <TextBlock Text="Synastry &amp; Composite"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF1B4F72"
                                   Margin="0,0,0,8" />

                        <!-- Synastry -->
                        <TextBlock Text="Synastry" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Person B"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding AllSavedCharts}"
                                      SelectedItem="{Binding Synastry.PersonB}"
                                      DisplayMemberPath="Name"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="Select a saved chart as Person B for synastry comparison" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Relationship"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding Synastry.RelationshipTypes}"
                                      SelectedItem="{Binding Synastry.SelectedRelationshipType}"
                                      ItemTemplate="{StaticResource DisplayTextItemTemplate}"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="Type of relationship for synastry interpretation context" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Rel. Notes"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding Synastry.RelationshipNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="e.g., married 15 years, business partners since 2010" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate Synastry"
                                    Command="{Binding CalculateSynastryCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="synastry"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the running synastry calculation" />
                            <Button Content="Export Synastry MD"
                                    Command="{Binding ExportSynastryMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- Composite Chart -->
                        <TextBlock Text="Composite Chart" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="Uses the Person B selected in Synastry above. Calculate a natal chart first, then select Person B."
                                   FontSize="11" Foreground="#FF888888"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Context"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Synastry.CompositeInterpretationContext, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Optional context for AI interpretation (e.g., relationship history, focus areas)" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate Composite"
                                    Command="{Binding CalculateCompositeCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="composite"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the running composite calculation" />
                            <Button Content="Export Composite MD"
                                    Command="{Binding ExportCompositeMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!--
                            Davison Chart (branch DavisonPanel, 1.7.0): the Composite section's twin for the
                            same two charts, a real chart cast for the midpoint moment at the midpoint place;
                            shown and exported only.
                        -->
                        <TextBlock Text="Davison Chart" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="A real chart cast for the midpoint of the two births, in time and place; the same two charts as the synastry above."
                                   FontSize="11" Foreground="#FF888888"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Context"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Synastry.DavisonInterpretationContext, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Optional context for AI interpretation (e.g., relationship history, focus areas)" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate Davison"
                                    Command="{Binding CalculateDavisonCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cast the Davison chart of the Chart panel's chart and Person B: the midpoint moment at the midpoint place." />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="davison"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the running Davison calculation" />
                            <Button Content="Export Davison MD"
                                    Command="{Binding ExportDavisonMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Export the Davison chart, complete, as Markdown." />
                        </WrapPanel>

                    </StackPanel>

                    <!-- ═══ TRANSITS PANEL ═══ -->
                    <StackPanel Visibility="{Binding IsTransitsPanelVisible,
                                Converter={StaticResource BoolToVisConverter}}">

                        <!-- Panel Header -->
                        <TextBlock Text="Transits &amp; Progressions"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF1B4F72"
                                   Margin="0,0,0,8" />

                        <!-- Transits -->
                        <TextBlock Text="Transits" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start Date"
                                       Style="{StaticResource FormLabel}" />
                            <DatePicker Grid.Row="0" Grid.Column="1"
                                        SelectedDate="{Binding Transits.StartDate}"
                                        Margin="0,2" Padding="4,3"
                                        ToolTip="First day of the transit report window" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="End Date"
                                       Style="{StaticResource FormLabel}" />
                            <DatePicker Grid.Row="1" Grid.Column="1"
                                        SelectedDate="{Binding Transits.EndDate}"
                                        Margin="0,2" Padding="4,3"
                                        ToolTip="Last day of the transit report window" />

                            <!-- The four techniques, each its own box since 1.4.0 (branch ModesPanel), Directions
                                 since 1.5.0 (branch PrimaryPanel), which takes the Directions panel's settings;
                                 Calculate needs one checked. Minor follows Transits: the minor aspects
                                 are the transits' only, and its tooltip shows while it is disabled. -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Transits"
                                       Style="{StaticResource FormLabel}" />
                            <CheckBox Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding Transits.IncludeTransits}"
                                      Content="Include transits"
                                      Margin="0,4"
                                      ToolTip="Include the transits: the transiting planets' aspects to the natal chart, their stations and ingresses, the house overlays and the midpoint activations" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Minor"
                                       Style="{StaticResource FormLabel}" />
                            <CheckBox Grid.Row="3" Grid.Column="1"
                                      IsChecked="{Binding Transits.IncludeMinorAspects}"
                                      IsEnabled="{Binding Transits.IncludeTransits}"
                                      Content="Include minor aspects"
                                      Margin="0,4"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="Transits only: include the semi-square, sesquiquadrate, semi-sextile and quincunx" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Solar Arc"
                                       Style="{StaticResource FormLabel}" />
                            <CheckBox Grid.Row="4" Grid.Column="1"
                                      IsChecked="{Binding Transits.IncludeSolarArcs}"
                                      Content="Include solar arc directions"
                                      Margin="0,4"
                                      ToolTip="Include the solar arc directions: the directed positions and their aspects at the start, and the dated hits in the period" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Progressions"
                                       Style="{StaticResource FormLabel}" />
                            <CheckBox Grid.Row="5" Grid.Column="1"
                                      IsChecked="{Binding Transits.IncludeSecondaryProgressions}"
                                      Content="Include secondary progressions"
                                      Margin="0,4"
                                      ToolTip="Include the secondary progressions: the progressed positions, Moon, stations and aspects at the start, and the dated hits in the period" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Directions"
                                       Style="{StaticResource FormLabel}" />
                            <CheckBox Grid.Row="6" Grid.Column="1"
                                      IsChecked="{Binding Transits.IncludePrimaryDirections}"
                                      Content="Include primary directions"
                                      Margin="0,4"
                                      ToolTip="Include the primary directions exact in the period, found with the Directions panel's settings" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Context"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,8,0" />
                            <TextBox Grid.Row="7" Grid.Column="1"
                                     Text="{Binding Transits.InterpretationContext, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Optional context for AI interpretation (e.g., Focus on career themes)" />
                        </Grid>

                        <!-- Calculate, Cancel, Export Report MD, Export Timeline MD (since 1.4.0, branch
                             ModesPanel; "Calculate Transits" and "Export Transit MD" until then). From this
                             markup (Padding 12,5, a 1 px border, MinWidth 100, the 6 px margins) and each
                             caption's Segoe UI advance at 13 DIP: 100, 100, 129.8 and 139.4 px, 493.2 against
                             the panel's 342. Export Report MD would bring the first line to 347.8, so the row
                             wraps 2+2, by 5.8 px. Computed on the Mac, not measured here: the same sum gives the
                             old row 519.5 where this head measured 519. -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate"
                                    Command="{Binding CalculateTransitCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Calculate the report for the checked techniques over the dates above. Needs a chart on the Chart panel and at least one of Transits, Solar Arc, Progressions and Directions checked; Directions takes the Directions panel's settings." />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="transits"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Transits calculation" />
                            <Button Content="Export Report MD"
                                    Command="{Binding ExportTransitMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Export the report as Markdown, titled for the techniques it holds" />
                            <Button Content="Export Timeline MD"
                                    Command="{Binding ExportTransitTimelineMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Export a chronological transit event timeline as Markdown. Needs a result with transits." />
                        </WrapPanel>

                        <!-- Daily Horoscope -->
                        <TextBlock Text="Daily Horoscope" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Generates a per-day transit digest from the calculated transit data above. Uses the same date range and natal chart."
                                   FontSize="10" Foreground="#FF888888" TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Export Daily Horoscope MD"
                                    Command="{Binding ExportDailyHoroscopeMarkdownCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Export a per-day transit digest as Markdown for AI interpretation. Needs a result with transits." />
                        </WrapPanel>

                        <!-- ── Return &amp; Ingress Timeline ─────────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Text="Return &amp; Ingress Timeline" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Years"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding ReturnIngressTimeline.StartYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Start year" Margin="0,2,4,2" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding ReturnIngressTimeline.EndYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="End year" Margin="0,2,0,2" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <CheckBox Content="Returns"
                                      IsChecked="{Binding ReturnIngressTimeline.IncludeReturns}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="Include planetary returns to natal positions (Mercury-Saturn)" />
                            <CheckBox Content="Ingresses"
                                      IsChecked="{Binding ReturnIngressTimeline.IncludeIngresses}"
                                      VerticalAlignment="Center"
                                      ToolTip="Include outer planet sign ingresses (Jupiter-Pluto + Chiron)" />
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button Content="Calculate Timeline"
                                    Command="{Binding CalculateRITimelineCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Calculate all returns and ingresses in the date range" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="returnIngressTimeline"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Return / Ingress Timeline calculation" />
                            <Button Content="Export MD"
                                    Command="{Binding ExportRITimelineCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                    </StackPanel>

                    <!-- ═══ RETURNS PANEL ═══ -->
                    <StackPanel Visibility="{Binding IsReturnsPanelVisible,
                                Converter={StaticResource BoolToVisConverter}}">

                        <!-- Panel Header -->
                        <TextBlock Text="Returns"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF1B4F72"
                                   Margin="0,0,0,8" />

                        <!-- Annual Profection -->
                        <StackPanel Visibility="{Binding Returns.HasProfection,
                                    Converter={StaticResource BoolToVisConverter}}"
                                    Margin="0,0,0,8">
                            <TextBlock Text="Annual Profection" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding Returns.ProfectionSummary}"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="#FF1B4F72" FontWeight="SemiBold"
                                       Margin="0,2,0,4" />
                            <TextBlock Text="{Binding Returns.FirdariaSummary}"
                                       TextWrapping="Wrap" FontSize="10"
                                       Foreground="#FF666666" Margin="0,1,0,1"
                                       Visibility="{Binding Returns.HasProfection, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock Text="{Binding Returns.ZodiacalReleasingSummary}"
                                       TextWrapping="Wrap" FontSize="10"
                                       Foreground="#FF666666" Margin="0,1,0,4"
                                       Visibility="{Binding Returns.HasProfection, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>

                        <!-- Solar Return -->
                        <TextBlock Text="Solar Return" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Year"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Returns.SolarReturnYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Year for solar return (e.g., 2026). Uses natal chart location." />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Context"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding Returns.SolarReturnInterpretationContext, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Optional context for AI interpretation (e.g., life situation, annual focus)" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate Solar Return"
                                    Command="{Binding CalculateSolarReturnCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="solarReturn"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the running solar return calculation" />
                            <Button Content="Export Solar Return MD"
                                    Command="{Binding ExportSolarReturnMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- Lunar Return -->
                        <TextBlock Text="Lunar Return" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start Date"
                                       Style="{StaticResource FormLabel}" />
                            <DatePicker Grid.Row="0" Grid.Column="1"
                                        SelectedDate="{Binding Returns.LunarReturnStartDate}"
                                        Margin="0,2" Padding="4,3"
                                        ToolTip="First day of the lunar return search window" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="End Date"
                                       Style="{StaticResource FormLabel}" />
                            <DatePicker Grid.Row="1" Grid.Column="1"
                                        SelectedDate="{Binding Returns.LunarReturnEndDate}"
                                        Margin="0,2" Padding="4,3"
                                        ToolTip="Last day of the lunar return search window" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Context"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,8,0" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding Returns.LunarReturnInterpretationContext, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Optional context for AI interpretation (e.g., current concerns, monthly focus)" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Results"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="3" Grid.Column="1"
                                      ItemsSource="{Binding Returns.LunarReturnResults}"
                                      SelectedItem="{Binding Returns.SelectedLunarReturn}"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="Select a lunar return to export">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="#{0} — {1:yyyy-MM-dd HH:mm} UTC">
                                                    <Binding Path="SequenceNumber" />
                                                    <Binding Path="ReturnChart.Input.LocalDateTime" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate Lunar Returns"
                                    Command="{Binding CalculateLunarReturnCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="lunarReturn"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Lunar Return calculation" />
                            <Button Content="Export Lunar Return MD"
                                    Command="{Binding ExportLunarReturnMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- Planetary Return -->
                        <TextBlock Text="Planetary Return" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Planet -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Planet"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding Returns.AvailableReturnPlanets}"
                                      SelectedItem="{Binding Returns.SelectedReturnPlanet}"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="Select the planet for the return chart" />

                            <!-- Row 1: Find Mode -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Find by"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding Returns.AvailableReturnFindModes}"
                                      SelectedItem="{Binding Returns.SelectedReturnFindMode}"
                                      ItemTemplate="{StaticResource DisplayTextItemTemplate}"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="By Year: find the return nearest to a year. By Return #: find the Nth return." />

                            <!-- Row 2: Return # (visible in ByReturnNumber mode) -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Return #"
                                       Style="{StaticResource FormLabel}"
                                       Visibility="{Binding Returns.IsReturnByNumber,
                                           Converter={StaticResource BoolToVisConverter}}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding Returns.ReturnNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Return number (1 = first return, 2 = second, etc.)"
                                     Visibility="{Binding Returns.IsReturnByNumber,
                                         Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Row 2 alt: Year (visible in ByYear mode) -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Year"
                                       Style="{StaticResource FormLabel}"
                                       Visibility="{Binding Returns.IsReturnByYear,
                                           Converter={StaticResource BoolToVisConverter}}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding Returns.ReturnYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Target year — finds the return nearest to mid-year"
                                     Visibility="{Binding Returns.IsReturnByYear,
                                         Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Row 3: Context -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Context"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding Returns.PlanetaryReturnInterpContext, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="50"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Optional interpretation context" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <Button Content="Calculate Return"
                                    Command="{Binding CalculatePlanetaryReturnCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="planetaryReturn"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Planetary Return calculation" />
                            <Button Content="Export Return MD"
                                    Command="{Binding ExportPlanetaryReturnMarkdownCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <CheckBox Content="Include snapshots"
                                      IsChecked="{Binding Cycles.IncludeCycleSnapshots}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      ToolTip="Include planetary position snapshots at each phase point" />
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <Button Content="Calculate Timeline"
                                    Command="{Binding CalculateCycleTimelineCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Calculate the full cycle between this return and the next" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="planetaryCycle"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Planetary Cycle Timeline calculation" />
                            <Button Content="Export Timeline MD"
                                    Command="{Binding ExportCycleTimelineMarkdownCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- ── Mundane Location ─────────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Text="Mundane Location" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Search"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Mundane.LocationSearch.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Type a city name (e.g., Washington, London, Beijing)" />
                            <Button Grid.Column="2" Content="Lookup"
                                    Command="{Binding LookupMundaneLocationCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="4,2,0,2" Width="55" />
                        </Grid>

                        <ComboBox ItemsSource="{Binding Mundane.LocationSearch.Results}"
                                  SelectedItem="{Binding Mundane.LocationSearch.SelectedResult}"
                                  DisplayMemberPath="DisplayName"
                                  IsDropDownOpen="{Binding Mundane.LocationSearch.IsDropDownOpen, Mode=TwoWay}"
                                  Margin="0,2,0,0" Padding="4,3" />

                        <TextBlock Text="{Binding Mundane.LocationName}"
                                   FontSize="10" Foreground="#FF1B4F72" FontWeight="SemiBold"
                                   Margin="0,2,0,6" TextWrapping="Wrap" />

                        <!-- ── Great Conjunctions ─────────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Text="Great Conjunctions" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Years"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Cycles.GCStartYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Start year" Margin="0,2,4,2" />
                            <TextBox Grid.Row="0" Grid.Column="2"
                                     Text="{Binding Cycles.GCEndYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="End year" Margin="0,2,0,2" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Find Conjunctions"
                                    Command="{Binding FindGreatConjunctionsCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="greatConjunctions"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Great Conjunctions search" />
                            <Button Content="Export Series MD"
                                    Command="{Binding ExportGCSeriesMarkdownCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- ── Synodic Cycles ─────────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Text="Synodic Cycles" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bodies"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding Cycles.SynodicBodyOptions}"
                                      SelectedItem="{Binding Cycles.SynodicBodyA}"
                                      Margin="0,2,4,2" Padding="4,3"
                                      ToolTip="First body (faster-moving)" />
                            <ComboBox Grid.Row="0" Grid.Column="2"
                                      ItemsSource="{Binding Cycles.SynodicBodyOptions}"
                                      SelectedItem="{Binding Cycles.SynodicBodyB}"
                                      Margin="0,2,0,2" Padding="4,3"
                                      ToolTip="Second body (slower-moving)" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Years"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding Cycles.SynodicStartYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Start year" Margin="0,2,4,2" />
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     Text="{Binding Cycles.SynodicEndYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="End year" Margin="0,2,0,2" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Find Conjunctions"
                                    Command="{Binding FindSynodicCyclesCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="synodicCycle"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Synodic Cycle search" />
                            <Button Content="Export Series MD"
                                    Command="{Binding ExportSynodicCycleMdCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- ── Ingress Charts ─────────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Text="Ingress Charts" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Planet"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding Mundane.AvailableIngressPlanets}"
                                      SelectedItem="{Binding Mundane.IngressPlanet}"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="Planet to track (Sun for cardinal ingresses)" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Year"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding Mundane.IngressYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Year to search" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <CheckBox Content="Cardinal only"
                                      IsChecked="{Binding Mundane.CardinalOnly}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="Show only equinox/solstice ingresses" />
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,8">
                            <Button Content="Find Ingresses"
                                    Command="{Binding FindIngressesCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Find ingress dates (timing only)" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="ingressSeries"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Ingress search" />
                            <Button Content="Calculate Cardinal Charts"
                                    Command="{Binding CalculateCardinalIngressesCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cast full charts for all 4 cardinal ingresses" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="cardinalIngresses"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Cardinal Ingress chart calculation" />
                            <Button Content="Export MD"
                                    Command="{Binding ExportIngressSeriesMarkdownCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export Cardinal MD"
                                    Command="{Binding ExportCardinalIngressesMarkdownCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- ── Lunation Charts ─────────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Text="Lunation Charts" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Year"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Mundane.LunationYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Year to find all New Moons and Full Moons" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button Content="Find Lunations"
                                    Command="{Binding FindLunationsCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Find all New/Full Moons for the year (timing only)" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="lunationSeries"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Lunation search" />
                            <Button Content="Calculate Charts"
                                    Command="{Binding CalculateLunationChartsCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cast full charts at all lunations using the mundane location" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="lunationCharts"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Lunation chart calculation" />
                            <Button Content="Export MD"
                                    Command="{Binding ExportLunationSeriesCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- ── Eclipse Calculator ───────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Text="Eclipse Calculator" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Years"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Mundane.EclipseStartYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Start year" Margin="0,2,4,2" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding Mundane.EclipseEndYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="End year" Margin="0,2,0,2" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button Content="Find Eclipses"
                                    Command="{Binding FindEclipsesCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Find all solar and lunar eclipses in the date range" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="eclipses"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Eclipse search" />
                            <Button Content="Export MD"
                                    Command="{Binding ExportEclipseSeriesCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- ── Mundane Aspect Finder ─────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Text="Mundane Aspect Finder" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Planet 1"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding Mundane.AvailableMundanePlanets}"
                                      SelectedItem="{Binding Mundane.MABody1}"
                                      Margin="0,2,4,2" Padding="4,3" />
                            <ComboBox Grid.Row="0" Grid.Column="2"
                                      ItemsSource="{Binding Mundane.AvailableMundanePlanets}"
                                      SelectedItem="{Binding Mundane.MABody2}"
                                      Margin="0,2,0,2" Padding="4,3" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Harmonic"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding Mundane.AvailableHarmonicModes}"
                                      SelectedItem="{Binding Mundane.MAHarmonicMode}"
                                      Margin="0,2,0,2" Padding="4,3"
                                      ToolTip="45° = full Ebertin cycle (8 phases). 90° = major aspects only (4 phases)." />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Years"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding Mundane.MAStartYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Start year" Margin="0,2,4,2" />
                            <TextBox Grid.Row="2" Grid.Column="2"
                                     Text="{Binding Mundane.MAEndYear, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="End year" Margin="0,2,0,2" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button Content="Find Aspects"
                                    Command="{Binding FindMundaneAspectsCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Find all exact aspects between the two bodies" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="mundaneAspects"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Mundane Aspects search" />
                            <Button Content="Export MD"
                                    Command="{Binding ExportMASeriesCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                    </StackPanel>

                    <!-- ═══ RELOCATION PANEL ═══ -->
                    <StackPanel Visibility="{Binding IsRelocationPanelVisible,
                                Converter={StaticResource BoolToVisConverter}}">

                        <!-- Panel Header -->
                        <TextBlock Text="Relocation"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF1B4F72"
                                   Margin="0,0,0,8" />

                        <!--
                            One birth chart, then a new place (1.4.0, item 3, branch
                            Relocate): a description line, then the Birth Chart and
                            New Location sections in the Chart panel's style, each a
                            section header and its grid on the 80 label column. Until
                            1.4.0 a grey hint hung under the picker by a margin copied
                            from that column; every line now sits in a grid.
                        -->
                        <TextBlock Text="Recast a birth chart for a new place: the same moment, with new angles and houses."
                                   FontSize="11" Foreground="#FF888888"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />

                        <!-- Birth Chart -->
                        <TextBlock Text="Birth Chart" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Chart"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding AllSavedCharts}"
                                      SelectedItem="{Binding Relocation.SelectedNatalChart}"
                                      DisplayMemberPath="Name"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="The birth chart to relocate. Loading or calculating a chart on the Chart panel picks it here." />

                            <!-- The chart in use: the picked chart, else the Chart panel's unsaved one, else none -->
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Relocation.ChartInUseText}"
                                       TextWrapping="Wrap" FontSize="12"
                                       Margin="4,2,0,4" />
                        </Grid>

                        <!-- New Location -->
                        <TextBlock Text="New Location" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Location Search -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Search"
                                       Style="{StaticResource FormLabel}" />
                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="Find"
                                        Command="{Binding LookupRelocationLocationCommand}"
                                        Style="{StaticResource ActionButton}"
                                        Width="50" Margin="4,0,0,0" />
                                <TextBox Text="{Binding Relocation.LocationSearch.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         ToolTip="Enter a city name to search (e.g., London, Tokyo, Sydney)" />
                            </DockPanel>

                            <!-- Location Results Dropdown -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Results"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding Relocation.LocationSearch.Results}"
                                      SelectedItem="{Binding Relocation.LocationSearch.SelectedResult}"
                                      DisplayMemberPath="DisplayName"
                                      IsDropDownOpen="{Binding Relocation.LocationSearch.IsDropDownOpen, Mode=TwoWay}"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="Pick a place to fill in its latitude, longitude and name" />

                            <!-- Latitude -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Latitude"
                                       Style="{StaticResource FormLabel}" />
                            <!--
                                Red border and the message as the tooltip while the
                                text is invalid (1.4.0, port plan §9 item 9): the
                                time-zone box's DataTrigger idiom. A blank box is not
                                marked.
                            -->
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding Relocation.LatitudeText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding Relocation.LatitudeToolTip}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Relocation.IsLatitudeValid}" Value="False">
                                                <Setter Property="BorderBrush" Value="Red" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- Longitude -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Longitude"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding Relocation.LongitudeText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding Relocation.LongitudeToolTip}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Relocation.IsLongitudeValid}" Value="False">
                                                <Setter Property="BorderBrush" Value="Red" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- Location Name (filled in from Results, editable) -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Location"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding Relocation.LocationName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Name of the new place (filled in from Results, or typed)" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate Relocation"
                                    Command="{Binding CalculateRelocationCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Recast the birth chart for the new place" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="relocation"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the running relocation calculation" />
                            <Button Content="Export Relocation MD"
                                    Command="{Binding ExportRelocationMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Export the relocated chart, with its angle and house changes, as Markdown" />
                        </WrapPanel>

                        <!-- The result line, shown while a result stands; it clears, and Export greys, when the chart or the place changes (1.6.1, StaleResult) -->
                        <TextBlock Text="{Binding Relocation.ResultSummary}"
                                   Visibility="{Binding Relocation.HasResult,
                                       Converter={StaticResource BoolToVisConverter}}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Margin="0,2,0,4" />

                    </StackPanel>

                    <!-- ═══ DIRECTIONS PANEL ═══ -->
                    <!--
                        Primary Directions (1.5.0, branch PrimaryPanel), in the Chart panel's
                        section style: a line, one Settings section of four rows on the 80 label
                        column, Calculate, Cancel and Export, the result line, and the list, the
                        whole-life report's own table (ListText), in the crossing report's font,
                        unwrapped, scrolling both ways. The two number boxes hold what was typed;
                        Calculate Directions greys out while either is outside the engine's limits.
                    -->
                    <StackPanel Visibility="{Binding IsDirectionsPanelVisible,
                                Converter={StaticResource BoolToVisConverter}}">

                        <!-- Panel Header -->
                        <TextBlock Text="Primary Directions"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF1B4F72"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="A dated list of Placidus semi-arc directions, zodiacal, direct and converse, for the chart on the Chart panel."
                                   FontSize="11" Foreground="#FF888888"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />

                        <!-- Settings -->
                        <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Key"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{x:Static vm:DirectionsViewModel.AvailableKeys}"
                                      SelectedItem="{Binding Directions.Key}"
                                      ItemTemplate="{StaticResource DisplayTextItemTemplate}"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="The key that turns an arc into years" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Planets"
                                       Style="{StaticResource FormLabel}" />
                            <CheckBox Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding Directions.PlanetsAsSignificators}"
                                      Content="Add Mercury to Pluto as significators"
                                      Margin="0,4"
                                      ToolTip="Direct to Mercury through Pluto as well as to the angles, the lights and the Lot" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Age limit"
                                       Style="{StaticResource FormLabel}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Directions.AgeLimitYears, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         Width="60" />
                                <TextBlock Text="years, 1 to 120"
                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                           FontSize="11" Foreground="#FF888888" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Uncertainty"
                                       Style="{StaticResource FormLabel}" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Directions.BirthTimeUncertaintyMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         Width="60" />
                                <TextBlock Text="minutes either way, 0 to 120; 0 for none"
                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                           FontSize="11" Foreground="#FF888888"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate Directions"
                                    Command="{Binding CalculateDirectionsCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="List the primary directions of the chart on the Chart panel. Needs a chart there, an age limit of 1 to 120 years and an uncertainty of 0 to 120." />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="directions"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the running primary directions calculation" />
                            <Button Content="Export Directions MD"
                                    Command="{Binding ExportDirectionsMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Export the whole-life Primary Directions Report as Markdown" />
                        </WrapPanel>

                        <!-- The result line, shown once directions are calculated -->
                        <TextBlock Text="{Binding Directions.ResultSummary}"
                                   Visibility="{Binding Directions.HasResult,
                                       Converter={StaticResource BoolToVisConverter}}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Margin="0,2,0,4" />

                        <!-- The list: the whole-life report's table, as the export writes it -->
                        <TextBox Text="{Binding Directions.ListText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Height="320"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Margin="0,4,0,4"
                                 Visibility="{Binding Directions.HasResult, Converter={StaticResource BoolToVisConverter}}" />

                    </StackPanel>

                    <!-- ═══ MAP (ASTROCARTOGRAPHY) PANEL ═══ -->
                    <StackPanel Visibility="{Binding IsMapPanelVisible,
                                Converter={StaticResource BoolToVisConverter}}">

                        <!-- Panel Header -->
                        <TextBlock Text="Astrocartography"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF1B4F72"
                                   Margin="0,0,0,8" />

                        <WrapPanel Margin="0,4,0,4">
                            <Button Content="Calculate ACG Map"
                                    Command="{Binding CalculateAcgCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Compute astrocartography lines for the natal chart" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="astrocartography"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Astrocartography calculation" />
                            <Button Content="Export ACG MD"
                                    Command="{Binding ExportAcgMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Export astrocartography data as Markdown" />
                        </WrapPanel>

                        <!-- Map opens in a separate floating window so it can use
                             the full screen instead of being squeezed by the sidebar. -->
                        <Button Content="Open Map Window"
                                Command="{Binding OpenAcgMapWindowCommand}"
                                Style="{StaticResource ActionButton}"
                                Margin="0,4,0,4"
                                FontSize="12"
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                ToolTip="Open the astrocartography map in a separate resizable window"
                                Visibility="{Binding Astrocartography.HasResult, Converter={StaticResource BoolToVisConverter}}" />

                        <!-- Planet Toggles -->
                        <TextBlock Text="Planets:" FontWeight="Bold" FontSize="10" Margin="0,4,0,2"
                                   Visibility="{Binding Astrocartography.HasResult, Converter={StaticResource BoolToVisConverter}}" />
                        <WrapPanel Margin="0,0,0,4"
                                   Visibility="{Binding Astrocartography.HasResult, Converter={StaticResource BoolToVisConverter}}">
                            <CheckBox Content="Sun" IsChecked="{Binding Astrocartography.ShowSun}" Margin="0,0,8,0" Foreground="#FFD700" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Moon" IsChecked="{Binding Astrocartography.ShowMoon}" Margin="0,0,8,0" Foreground="#C0C0C0" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Mercury" IsChecked="{Binding Astrocartography.ShowMercury}" Margin="0,0,8,0" Foreground="#FF8C00" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Venus" IsChecked="{Binding Astrocartography.ShowVenus}" Margin="0,0,8,0" Foreground="#32CD32" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Mars" IsChecked="{Binding Astrocartography.ShowMars}" Margin="0,0,8,0" Foreground="#DC143C" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Jupiter" IsChecked="{Binding Astrocartography.ShowJupiter}" Margin="0,0,8,0" Foreground="#8A2BE2" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Saturn" IsChecked="{Binding Astrocartography.ShowSaturn}" Margin="0,0,8,0" Foreground="#00008B" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Uranus" IsChecked="{Binding Astrocartography.ShowUranus}" Margin="0,0,8,0" Foreground="#00CED1" FontSize="10" />
                            <CheckBox Content="Neptune" IsChecked="{Binding Astrocartography.ShowNeptune}" Margin="0,0,8,0" Foreground="#008080" FontSize="10" />
                            <CheckBox Content="Pluto" IsChecked="{Binding Astrocartography.ShowPluto}" Margin="0,0,8,0" Foreground="#8B0000" FontSize="10" />
                            <CheckBox Content="Chiron" IsChecked="{Binding Astrocartography.ShowChiron}" Margin="0,0,8,0" Foreground="#8B4513" FontSize="10" />
                            <CheckBox Content="Node" IsChecked="{Binding Astrocartography.ShowNorthNode}" Margin="0,0,8,0" Foreground="#696969" FontSize="10" />
                        </WrapPanel>

                        <!-- Line Type Toggles -->
                        <WrapPanel Margin="0,0,0,4"
                                   Visibility="{Binding Astrocartography.HasResult, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Lines:" FontWeight="Bold" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <CheckBox Content="MC" IsChecked="{Binding Astrocartography.ShowMcLines}" Margin="0,0,8,0" FontSize="10" />
                            <CheckBox Content="IC" IsChecked="{Binding Astrocartography.ShowIcLines}" Margin="0,0,8,0" FontSize="10" />
                            <CheckBox Content="ASC" IsChecked="{Binding Astrocartography.ShowAscLines}" Margin="0,0,8,0" FontSize="10" />
                            <CheckBox Content="DSC" IsChecked="{Binding Astrocartography.ShowDscLines}" Margin="0,0,8,0" FontSize="10" />
                        </WrapPanel>

                        <!-- Crossing Report -->
                        <TextBox Text="{Binding Astrocartography.CrossingReportText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="9"
                                 Height="80"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,4"
                                 Visibility="{Binding Astrocartography.HasResult, Converter={StaticResource BoolToVisConverter}}" />

                    </StackPanel>

                    <!-- ═══ ELECTIONAL PANEL ═══ -->
                    <StackPanel Visibility="{Binding IsElectionalPanelVisible,
                                Converter={StaticResource BoolToVisConverter}}">

                        <!-- Panel Header -->
                        <TextBlock Text="Electional Astrology"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF1B4F72"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="Electional" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                Row 0: Natal Chart. The field cell holds the picker and, under it, the line
                                naming the chart in use: the picked chart, else the Chart panel's unsaved one,
                                else none. Each Load and Calculate & Save on the Chart panel picks its chart
                                here (1.6.1, branch ElectionalPicker).
                            -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Natal Chart"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,8,0" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                                <ComboBox ItemsSource="{Binding AllSavedCharts}"
                                          SelectedItem="{Binding Electional.SelectedNatalChart}"
                                          DisplayMemberPath="Name"
                                          Margin="0,2" Padding="4,3"
                                          ToolTip="The natal chart the search scores against. Loading or calculating a chart on the Chart panel picks it here; with none picked, the Chart panel's chart is used, or else one cast from its fields." />
                                <TextBlock Text="{Binding Electional.ChartInUseText}"
                                           TextWrapping="Wrap" FontSize="12"
                                           Margin="4,2,0,4" />
                            </StackPanel>

                            <!-- Row 1: Election Type -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Type"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding Electional.ElectionTypes}"
                                      SelectedItem="{Binding Electional.ElectionType}"
                                      ItemTemplate="{StaticResource DisplayTextItemTemplate}"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="Category of event (Business Launch, Wedding, etc.)" />

                            <!-- Row 2: Goal -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Goal"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,8,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding Electional.Goal, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="50"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Describe the purpose of this election (e.g., Launch new product line)" />

                            <!-- Row 3: Start Date -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Start"
                                       Style="{StaticResource FormLabel}" />
                            <DatePicker Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                        SelectedDate="{Binding Electional.StartDate}"
                                        Margin="0,2" Padding="4,3"
                                        ToolTip="Earliest acceptable date for the event" />

                            <!-- Row 4: End Date -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="End"
                                       Style="{StaticResource FormLabel}" />
                            <DatePicker Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                        SelectedDate="{Binding Electional.EndDate}"
                                        Margin="0,2" Padding="4,3"
                                        ToolTip="Latest acceptable date for the event" />

                            <!-- Row 5: Location Lookup with Lookup and Use Natal buttons -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Lookup"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Text="{Binding Electional.LocationSearch.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Enter city name to search (e.g., Richmond, VA)">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding LookupElectionalLocationCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Lookup"
                                        Command="{Binding LookupElectionalLocationCommand}"
                                        Padding="8,3"
                                        Margin="4,2,2,2" />
                                <Button Content="Use Natal"
                                        Command="{Binding UseNatalLocationCommand}"
                                        Padding="8,3"
                                        Margin="2,2,0,2"
                                        ToolTip="Copy location from natal chart" />
                            </StackPanel>

                            <!-- Row 6: Results Dropdown -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Results"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding Electional.LocationSearch.Results}"
                                      SelectedItem="{Binding Electional.LocationSearch.SelectedResult}"
                                      IsDropDownOpen="{Binding Electional.LocationSearch.IsDropDownOpen, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip="Select a result to fill in coordinates and timezone" />

                            <!-- Row 7: Location Name -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Location"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding Electional.LocationName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="City, State/Country for the event" />

                            <!-- Row 8: Latitude -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Latitude"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding Electional.LatitudeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Decimal degrees (positive = North)" />

                            <!-- Row 9: Longitude -->
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Longitude"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding Electional.LongitudeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Decimal degrees (positive = East)" />

                            <!-- Row 10: Timezone -->
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Timezone"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding Electional.FilteredTimezones}"
                                      SelectedItem="{Binding Electional.SelectedTimezone}"
                                      Text="{Binding Electional.TimeZone, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      Margin="0,2" Padding="4,3"
                                      MaxDropDownHeight="300"
                                      ToolTip="IANA timezone ID (e.g., America/New_York)">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Electional.IsTimezoneValid}" Value="False">
                                                <Setter Property="BorderBrush" Value="Red" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="ToolTip" Value="Unrecognized timezone. Select from the list or type a valid IANA timezone ID." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <!-- Row 11: Candidates -->
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Candidates"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding Electional.CandidateCount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Number of candidate windows to return (1-5)" />

                            <!-- Row 12: Earliest Time -->
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Earliest"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding Electional.EarliestTimeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Earliest acceptable local time in HH:mm format (e.g., 09:00). Leave both Earliest and Latest empty for any time; fill in both to limit candidates to local times within the window." />

                            <!-- Row 13: Latest Time -->
                            <TextBlock Grid.Row="13" Grid.Column="0" Text="Latest"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding Electional.LatestTimeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     ToolTip="Latest acceptable local time in HH:mm format (e.g., 17:00). Leave both Earliest and Latest empty for any time; fill in both to limit candidates to local times within the window." />

                            <!-- Row 14: Allowed Days -->
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Days"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,8,0"
                                       ToolTip="Allowed days: candidates are limited to the checked days of the week" />
                            <WrapPanel Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2"
                                       Orientation="Horizontal"
                                       Margin="0,4">
                                <CheckBox Content="Mon" IsChecked="{Binding Electional.AllowMonday}" Margin="0,0,8,2"
                                          ToolTip="Allow candidates on Mondays" />
                                <CheckBox Content="Tue" IsChecked="{Binding Electional.AllowTuesday}" Margin="0,0,8,2"
                                          ToolTip="Allow candidates on Tuesdays" />
                                <CheckBox Content="Wed" IsChecked="{Binding Electional.AllowWednesday}" Margin="0,0,8,2"
                                          ToolTip="Allow candidates on Wednesdays" />
                                <CheckBox Content="Thu" IsChecked="{Binding Electional.AllowThursday}" Margin="0,0,8,2"
                                          ToolTip="Allow candidates on Thursdays" />
                                <CheckBox Content="Fri" IsChecked="{Binding Electional.AllowFriday}" Margin="0,0,8,2"
                                          ToolTip="Allow candidates on Fridays" />
                                <CheckBox Content="Sat" IsChecked="{Binding Electional.AllowSaturday}" Margin="0,0,8,2"
                                          ToolTip="Allow candidates on Saturdays" />
                                <CheckBox Content="Sun" IsChecked="{Binding Electional.AllowSunday}" Margin="0,0,8,2"
                                          ToolTip="Allow candidates on Sundays" />
                            </WrapPanel>

                            <!-- Row 15: Mercury Retrograde -->
                            <TextBlock Grid.Row="15" Grid.Column="0" Text="Mercury Rx"
                                       Style="{StaticResource FormLabel}" />
                            <CheckBox Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2"
                                      IsChecked="{Binding Electional.AvoidMercuryRetrograde}"
                                      Content="Avoid Mercury retrograde"
                                      Margin="0,4"
                                      ToolTip="Exclude dates when Mercury is retrograde" />

                            <!-- Row 16: Constraint Notes -->
                            <TextBlock Grid.Row="16" Grid.Column="0" Text="Notes"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,8,0" />
                            <TextBox Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding Electional.ConstraintNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="50"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Additional constraints or notes for the election" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate Electional"
                                    Command="{Binding CalculateElectionalCommand}"
                                    Style="{StaticResource ExportButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="electional"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the active Electional search" />
                            <Button Content="Export Electional MD"
                                    Command="{Binding ExportElectionalMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                    </StackPanel>

                    <!-- ═══ MEDICAL PANEL ═══ -->
                    <StackPanel Visibility="{Binding IsMedicalPanelVisible,
                                Converter={StaticResource BoolToVisConverter}}">

                        <!-- Panel Header -->
                        <TextBlock Text="Medical Astrology"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF1B4F72"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="Medical Astrology" Style="{StaticResource SectionHeader}" />

                        <!-- Health Context input -->
                        <TextBlock Text="Health Context (optional)"
                                   Style="{StaticResource FormLabel}"
                                   Margin="0,12,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF555555"
                                   Margin="0,0,0,6"
                                   Text="Describe any known conditions, symptoms, or health history. This text is included verbatim in the exported report header for AI-assisted interpretation." />
                        <TextBox Text="{Binding MedicalHealthContext, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="100"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,12"
                                 FontSize="12" />

                        <!-- Export button -->
                        <Button Content="Export Medical Report (Markdown)"
                                Command="{Binding ExportMedicalMarkdownCommand}"
                                Style="{StaticResource ActionButton}"
                                Margin="0,0,0,8"
                                ToolTip="Generate a medical astrology report for the current natal chart and save it as a Markdown file." />

                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF888888"
                                   Margin="0,4,0,0"
                                   Text="Report includes: the natal chart, Temperament Assessment, Zodiacal Anatomy, Planetary Body Correspondences, Hard Aspects (medical significance) and Health Houses (6th, 8th, 12th)." />
                    </StackPanel>

                    <!-- ═══ EXPORT PANEL ═══ -->
                    <StackPanel Visibility="{Binding IsExportPanelVisible,
                                Converter={StaticResource BoolToVisConverter}}">

                        <!-- Panel Header -->
                        <TextBlock Text="Export &amp; Backup"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF1B4F72"
                                   Margin="0,0,0,8" />

                        <!-- Chart Exports -->
                        <TextBlock Text="Chart Export" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF666666" Margin="0,4,0,4" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Export PDF"
                                    Command="{Binding ExportPdfCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export Markdown"
                                    Command="{Binding ExportMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export JSON"
                                    Command="{Binding ExportChartJsonCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export Both"
                                    Command="{Binding ExportBothCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Cancel PDF"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="pdfSave"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Cancel the running PDF export" />
                        </WrapPanel>

                        <!-- Synastry/Composite/Davison Exports (the third since branch DavisonPanel, 1.7.0) -->
                        <TextBlock Text="Synastry, Composite &amp; Davison" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF666666" Margin="0,4,0,4" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Export Synastry MD"
                                    Command="{Binding ExportSynastryMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export Composite MD"
                                    Command="{Binding ExportCompositeMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export Davison MD"
                                    Command="{Binding ExportDavisonMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- Transit Export -->
                        <TextBlock Text="Transits" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF666666" Margin="0,4,0,4" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Export Report MD"
                                    Command="{Binding ExportTransitMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export Timeline MD"
                                    Command="{Binding ExportTransitTimelineMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- Primary Directions Export (1.5.0, branch PrimaryPanel) -->
                        <TextBlock Text="Primary Directions" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF666666" Margin="0,4,0,4" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Export Directions MD"
                                    Command="{Binding ExportDirectionsMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- Daily Horoscope Export -->
                        <TextBlock Text="Daily Horoscope" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF666666" Margin="0,4,0,4" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Export Daily Horoscope MD"
                                    Command="{Binding ExportDailyHoroscopeMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export RI Timeline MD"
                                    Command="{Binding ExportRITimelineCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- Return Exports -->
                        <TextBlock Text="Returns" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF666666" Margin="0,4,0,4" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Export Solar Return MD"
                                    Command="{Binding ExportSolarReturnMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export Lunar Return MD"
                                    Command="{Binding ExportLunarReturnMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export Planetary Return MD"
                                    Command="{Binding ExportPlanetaryReturnMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export Cycle Timeline MD"
                                    Command="{Binding ExportCycleTimelineMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                            <Button Content="Export GC Series MD"
                                    Command="{Binding ExportGCSeriesMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- Electional Export -->
                        <TextBlock Text="Electional" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF666666" Margin="0,4,0,4" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Export Electional MD"
                                    Command="{Binding ExportElectionalMarkdownCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2" />
                        </WrapPanel>

                        <!-- Database Backup -->
                        <TextBlock Text="Database Backup" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF666666" Margin="0,8,0,4" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Export Backup"
                                    Command="{Binding ExportDatabaseCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Export all charts to a JSON file for backup or transfer" />
                            <Button Content="Import Backup"
                                    Command="{Binding ImportDatabaseCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,2,6,2"
                                    ToolTip="Import charts from a JSON file (updates existing, adds new)" />
                        </WrapPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Vertical Splitter -->
            <GridSplitter Grid.Column="2"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#FFCCCCCC" />

            <!-- ════════════════════════════════════════ -->
            <!-- RIGHT PANEL: Saved Charts List          -->
            <!-- ════════════════════════════════════════ -->
            <DockPanel Grid.Column="3" Margin="8,0,0,0">

                <TextBlock Text="Saved Charts"
                           Style="{StaticResource SectionHeader}"
                           DockPanel.Dock="Top" />

                <!-- Search Bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             ToolTip="Search by name" />
                    <Button Grid.Column="1"
                            Content="Search"
                            Command="{Binding SearchChartsCommand}"
                            Style="{StaticResource ActionButton}"
                            Margin="6,2,0,2" />
                </Grid>

                <!-- Filter Controls -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Event Type + Sort -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Type"
                               Style="{StaticResource FormLabel}" Margin="0,0,4,0" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding EventTypeFilterOptions}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="DisplayName"
                              SelectedValue="{Binding FilterEventType}"
                              Margin="0,2" Padding="4,3"
                              ToolTip="Filter by event type (All = no filter)" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Sort"
                               Style="{StaticResource FormLabel}" Margin="8,0,4,0" />
                    <StackPanel Grid.Row="0" Grid.Column="3"
                                Orientation="Horizontal" Margin="0,2">
                        <ComboBox ItemsSource="{Binding SortFieldValues}"
                                  SelectedItem="{Binding SortField}"
                                  ItemTemplate="{StaticResource DisplayTextItemTemplate}"
                                  MinWidth="80" Padding="4,3"
                                  ToolTip="Sort field" />
                        <Button Padding="6,3" Margin="4,0,0,0"
                                Command="{Binding ToggleSortDirectionCommand}"
                                ToolTip="Toggle sort direction">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="A-Z" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                            <Setter Property="Content" Value="Z-A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Row 1: Date Range -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="From"
                               Style="{StaticResource FormLabel}" Margin="0,0,4,0" />
                    <DatePicker Grid.Row="1" Grid.Column="1"
                                SelectedDate="{Binding FilterDateFrom}"
                                Margin="0,2" Padding="4,3"
                                ToolTip="Filter charts from this date" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="To"
                               Style="{StaticResource FormLabel}" Margin="8,0,4,0" />
                    <DatePicker Grid.Row="1" Grid.Column="3"
                                SelectedDate="{Binding FilterDateTo}"
                                Margin="0,2" Padding="4,3"
                                ToolTip="Filter charts up to this date" />
                </Grid>

                <!-- Charts ListView -->
                <ListView ItemsSource="{Binding SavedCharts}"
                          SelectionMode="Single"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FFDDDDDD"
                                    BorderThickness="0,0,0,1"
                                    Padding="4,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <!-- The type by name, the place and the reading as typed (1.4.0, E3-6). -->
                                        <TextBlock FontSize="11" Foreground="#FF666666"
                                                   Text="{Binding Converter={StaticResource DisplayTextConverter}}" />
                                        <TextBlock Text="{Binding Keywords}"
                                                   FontSize="10"
                                                   Foreground="#FF999999"
                                                   FontStyle="Italic">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Keywords}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Keywords}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Load"
                                                Command="{Binding DataContext.LoadChartCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3"
                                                Margin="4,0" />
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteChartCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3"
                                                Margin="4,0"
                                                Foreground="#FFD9534F" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </DockPanel>

        </Grid>

    </DockPanel>
</Window>
