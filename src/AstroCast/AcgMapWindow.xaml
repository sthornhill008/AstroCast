<Window x:Class="AstroCast.AcgMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="AstroCast — Astrocartography Map"
        Width="1200" Height="800"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/AstroCast.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Map fills the entire window above the status bar -->
        <mapsui:MapControl x:Name="AcgMapControl"
                           Grid.Row="0"
                           ClipToBounds="True" />

        <!-- Status bar with crossing report; updated on each map tap -->
        <StatusBar Grid.Row="1" Background="#FF1B2A4A">
            <StatusBarItem>
                <TextBlock x:Name="CrossingReportText"
                           Foreground="White"
                           FontFamily="Consolas"
                           FontSize="10"
                           TextWrapping="NoWrap"
                           Text="Click the map to see nearby angular lines." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
