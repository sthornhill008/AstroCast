<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AstroCast.ViewModels"
        xmlns:enums="using:AstroCast.Core.Enums"
        xmlns:data="using:AstroCast.Core.Data"
        xmlns:models="using:AstroCast.Core.Models"
        xmlns:pd="using:AstroCast.Core.Models.PrimaryDirections"
        xmlns:conv="using:AstroCast.Avalonia.Converters"
        x:Class="AstroCast.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="950" Height="600"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <!--
        Keyboard navigation. WPF's Window.InputBindings becomes
        Window.KeyBindings; the KeyBinding element and the x:Static command
        parameters carry over unchanged.

        THE GESTURE SYNTAX DOES NOT. WPF writes Gesture="Alt+1"; Avalonia must be
        given Gesture="Alt+D1". Avalonia's KeyGesture parser falls back to parsing
        a bare digit as a NUMERIC Key enum value, so "Alt+1" silently yields
        Key.Cancel (enum value 1) and "Alt+9" yields Key.HangulMode (9) — valid
        gestures bound to the wrong keys, with no parse error and no warning. The
        shortcuts simply never fire, and nothing in a build or a launch reveals
        it. KeyBindings_MapAltNumberToTheExpectedPanel in AstroCast.UiTests pins
        the mapping so a future edit cannot silently reintroduce it.

        The Alt+N numbering is also NOT the sidebar's visual order, and must not
        be "tidied" to match it: Relocation is the fifth button but Alt+9 (it was
        promoted to a top-level panel after the first eight were numbered), and
        Map/Export are visually 9th/10th while bound to Alt+8/Alt+7. Directions,
        the tenth panel (1.5.0, branch PrimaryPanel), is Alt+0, the last free
        digit.
    -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Alt+D1" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Chart}" />
        <KeyBinding Gesture="Alt+D2" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Synastry}" />
        <KeyBinding Gesture="Alt+D3" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Transits}" />
        <KeyBinding Gesture="Alt+D4" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Returns}" />
        <KeyBinding Gesture="Alt+D5" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Electional}" />
        <KeyBinding Gesture="Alt+D6" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Medical}" />
        <KeyBinding Gesture="Alt+D7" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Export}" />
        <KeyBinding Gesture="Alt+D8" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Map}" />
        <KeyBinding Gesture="Alt+D9" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Relocation}" />
        <KeyBinding Gesture="Alt+D0" Command="{Binding NavigateToPanelCommand}"
                    CommandParameter="{x:Static vm:NavigationPanel.Directions}" />
    </Window.KeyBindings>

    <!--
        The screen's names for enums and saved charts (1.4.0, E3-6): every
        name-bearing ComboBox's DisplayMemberBinding and the saved-chart row go
        through DisplayText, so SelectedItem stays the enum or the entity.
    -->
    <Window.Resources>
        <conv:DisplayTextConverter x:Key="DisplayTextConverter" />
    </Window.Resources>

    <!--
        WPF's keyed Window.Resources styles become selector-based Window.Styles.
        There is no Avalonia equivalent of {StaticResource SomeStyle}: a style is
        applied by matching a selector, so each former x:Key becomes a class name
        that consuming elements opt into via Classes="…".

        The former SidebarButton ControlTemplate.Triggers -> IsMouseOver becomes
        the :pointerover pseudo-class. Selector order is load-bearing: later
        matching styles win, so .nav.active is declared after .nav:pointerover to
        reproduce WPF's precedence, where the Style's DataTrigger beat the
        ControlTemplate's own trigger.
    -->
    <Window.Styles>

        <!--
            Sidebar navigation button (former x:Key="SidebarButton"). Padding
            4,5 and the caption's top margin 1 since 1.5.0 (branch PrimaryPanel,
            scoping decision 2a), 4,8 and 2 until then: the tenth button,
            Directions, fits the default 600 px window only so.
        -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFAABBCC" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Width" Value="56" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Hover (former ControlTemplate.Triggers -> IsMouseOver). -->
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#FF253D54" />
            <Setter Property="Foreground" Value="#FFDDEEFF" />
        </Style>

        <!--
            Active panel highlight. This one selector replaces all ten
            DataTrigger blocks from the WPF markup: each button binds
            Classes.active to its own Is<Panel>PanelVisible property, which is
            defined as ActivePanel == NavigationPanel.<Panel> — exactly the
            condition the DataTriggers tested.
        -->
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#FF253D54" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF4A90D9" />
        </Style>

        <!-- Glyph and caption inside a navigation button. -->
        <Style Selector="Button.nav TextBlock.glyph">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav TextBlock.caption">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <!-- Panel heading (former x:Key="SectionHeader"). -->
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF4A90D9" />
            <Setter Property="Margin" Value="0,8,0,6" />
        </Style>

        <!--
            Panel title, matching the per-panel header in the WPF markup. All
            ten WPF headers carry Foreground="#FF1B4F72" inline; slice 1 omitted
            it when factoring them into this class, so the headings rendered in
            the theme's default foreground rather than the dark blue.
        -->
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF1B4F72" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--
            Export-panel group heading. The seven headings inside the WPF Export
            panel are NOT the SectionHeader resource the rest of the window uses:
            they carry FontSize="11" FontWeight="SemiBold" Foreground="#FF666666"
            inline, which is smaller and grey where SectionHeader is 13pt bold
            blue. Factored into a class here rather than repeated seven times;
            using sectionHeader instead would have silently restyled them.

            "Database Backup" alone carries Margin="0,8,0,4" rather than
            "0,4,0,4" — an extra four pixels above, separating the destructive
            section from the export sections. It overrides Margin inline.
        -->
        <Style Selector="TextBlock.exportGroup">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF666666" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>

        <!--
            Sort-direction toggle. WPF expresses this as a Button.Style whose
            Content Setter is overridden by a DataTrigger on SortAscending.
            Avalonia selectors cannot test a view-model property, so the button
            opts into the "descending" class through a negated binding —
            Classes.descending="{Binding !SortAscending}" — and these two styles
            supply what the Setter and its DataTrigger did. Same mechanism as
            AutoCompleteBox.invalidTimezone above.
        -->
        <Style Selector="Button.sortDirection">
            <Setter Property="Content" Value="A-Z" />
        </Style>

        <Style Selector="Button.sortDirection.descending">
            <Setter Property="Content" Value="Z-A" />
        </Style>

        <!-- Form label (former x:Key="FormLabel"). -->
        <Style Selector="TextBlock.formLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF333333" />
        </Style>

        <!-- Form text box (former x:Key="FormTextBox"). -->
        <Style Selector="TextBox.formTextBox">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--
            Action button (former x:Key="ActionButton"). WPF's ExportButton was
            BasedOn this one; Avalonia has no BasedOn for selector styles, so the
            export buttons opt into both classes instead — Classes="action export".
        -->
        <!--
            HorizontalContentAlignment="Center" restores a WPF theme default,
            like the Stretch on the Medical button. WPF's Button theme style
            centres content — measured, not inferred: on the running WPF head
            the "Cancel" caption sits 31 px inside a 100 px button, and
            (100 - 38) / 2 = 31, where a left-aligned caption would sit at 13
            (Padding 12 + border 1).

            Fluent does NOT set the property at all. It stays at Avalonia's
            registered default of Stretch, which stretches the caption TextBlock
            across the whole button; TextBlock.TextAlignment then defaults to
            Start and the glyphs render against the left padding edge. So the
            outcome is left-aligned but the mechanism is Stretch, and setting
            Center is what collapses the TextBlock to its natural width and
            centres it.

            This only shows where a button has horizontal slack, which MinWidth
            100 creates for any caption narrower than the 74 px inner box.
            Eleven already-translated buttons move, nine by 3 px or more —
            largest are the stretched Medical export button (58 px) and Clear
            (22 px); the five Cancels move 18. The other 25 action buttons have
            captions wider than the inner box, auto-size to caption + 26, and
            already render at 13 px in BOTH heads, so for them this is a
            measured no-op. Every movement is toward the WPF geometry, never
            away from it.
        -->
        <Style Selector="Button.action">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Export button (former x:Key="ExportButton"). -->
        <Style Selector="Button.export">
            <Setter Property="Background" Value="#FF4A90D9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#FF3A7BC8" />
        </Style>

        <!--
            Unrecognised timezone. Replaces the WPF ComboBox.Style DataTrigger on
            ChartEntry.IsTimezoneValid: a selector cannot test a view-model
            property directly, so the control opts into the class through a
            negated binding and this style supplies what the DataTrigger's three
            Setters did — including the tooltip replacement, which works because
            ToolTip.Tip is an attached property and Setter addresses it as one.
        -->
        <Style Selector="AutoCompleteBox.invalidTimezone">
            <Setter Property="BorderBrush" Value="Red" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="ToolTip.Tip"
                    Value="Unrecognized timezone. Select from the list or type a valid IANA timezone ID." />
        </Style>

        <!--
            An invalid coordinate (1.4.0, port plan §9 item 9): the time-zone
            idiom for the Relocation panel's latitude and longitude boxes. Each
            opts into the class through a negated binding on IsLatitudeValid or
            IsLongitudeValid, and binds its tooltip to the view model, which gives
            the message while the text is invalid. A blank box is not marked.
            Fluent's TextBox template draws the border on PART_BorderElement and
            sets that part itself while the box is hovered or focused, so the
            part is styled for those states too: otherwise the red would vanish
            exactly while the user types.
        -->
        <Style Selector="TextBox.invalidCoordinate">
            <Setter Property="BorderBrush" Value="Red" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBox.invalidCoordinate:pointerover /template/ Border#PART_BorderElement, TextBox.invalidCoordinate:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Red" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!--
            The time-zone pickers' chevron (O-8, H-01): a ToggleButton in each
            AutoCompleteBox's InnerRightContent, its IsChecked bound two-way to
            that box's IsDropDownOpen. Its own template, so it draws the glyph
            alone, as the chevron always looked: Fluent's ToggleButton template
            paints a background and turns accent-coloured while checked. The
            Transparent background is what makes its whole area take the click.
            Cursor Arrow, as over a ComboBox's chevron, where the text box's
            I-beam would otherwise be inherited.

            Not focusable: the keyboard stays in the text field, the toggle adds
            no tab stop, and the list still opens on typing as before.
        -->
        <Style Selector="ToggleButton.timezoneChevron">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Status bar text. -->
        <Style Selector="TextBlock.status">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Styles>

    <DockPanel>

        <!--
            Status bar. Avalonia has no StatusBar/StatusBarItem, so the WPF
            control becomes a docked Border with an explicit three-column Grid:
            status text, active-operation indicator, version.
        -->
        <Border DockPanel.Dock="Bottom"
                Background="#FFF0F0F0"
                BorderBrush="#FFDDDDDD"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <TextBlock Grid.Column="0"
                           Classes="status"
                           Text="{Binding StatusText}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            IsVisible="{Binding HasActiveOperation}">
                    <TextBlock Text="{Binding ActiveOperationDisplayName,
                                              StringFormat='Active: {0}'}"
                               Margin="12,0,0,0"
                               Foreground="#FF4A90D9"
                               FontStyle="Italic"
                               VerticalAlignment="Center" />
                    <Button Content="Cancel All"
                            Command="{Binding CancelCommand}"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            ToolTip.Tip="Cancel every active calculation" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <TextBlock Classes="status"
                               Foreground="#FF888888"
                               Text="{Binding AppVersion, StringFormat='v{0}'}" />
                    <Button Content="About"
                            Command="{Binding OpenAboutWindowCommand}"
                            AutomationProperties.Name="About AstroCast"
                            ToolTip.Tip="Version, licence and third-party notices"
                            Padding="8,2"
                            Margin="8,0,0,0" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main content: navigation rail | panel host | splitter | chart list -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="360" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════════════ -->
            <!-- SIDEBAR: Navigation Icon Rail            -->
            <!-- ════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="#FF1B2838"
                    Padding="0,8">
                <StackPanel>

                    <Button Classes="nav"
                            Classes.active="{Binding IsChartPanelVisible}"
                            Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Chart}"
                            AutomationProperties.Name="Chart"
                            ToolTip.Tip="Natal Chart Input (Alt+1)">
                        <StackPanel>
                            <TextBlock Classes="glyph" Text="&#x2609;" />
                            <TextBlock Classes="caption" Text="Chart" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsSynastryPanelVisible}"
                            Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Synastry}"
                            AutomationProperties.Name="Synastry"
                            ToolTip.Tip="Synastry &amp; Composite (Alt+2)">
                        <StackPanel>
                            <TextBlock Classes="glyph" Text="&#x260C;" />
                            <TextBlock Classes="caption" Text="Synastry" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsTransitsPanelVisible}"
                            Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Transits}"
                            AutomationProperties.Name="Transits"
                            ToolTip.Tip="Transits &amp; Progressions (Alt+3)">
                        <StackPanel>
                            <TextBlock Classes="glyph" Text="&#x21BB;" />
                            <TextBlock Classes="caption" Text="Transits" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsReturnsPanelVisible}"
                            Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Returns}"
                            AutomationProperties.Name="Returns"
                            ToolTip.Tip="Solar &amp; Lunar Returns (Alt+4)">
                        <StackPanel>
                            <TextBlock Classes="glyph" Text="&#x2600;" />
                            <TextBlock Classes="caption" Text="Returns" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsRelocationPanelVisible}"
                            Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Relocation}"
                            AutomationProperties.Name="Relocation"
                            ToolTip.Tip="Relocation Chart (Alt+9)">
                        <StackPanel>
                            <TextBlock Classes="glyph" Text="&#x1F9ED;" />
                            <TextBlock Classes="caption" Text="Relocate" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsDirectionsPanelVisible}"
                            Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Directions}"
                            AutomationProperties.Name="Directions"
                            ToolTip.Tip="Primary Directions (Alt+0)">
                        <StackPanel>
                            <TextBlock Classes="glyph" Text="&#x2192;" />
                            <TextBlock Classes="caption" Text="Primary" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsElectionalPanelVisible}"
                            Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Electional}"
                            AutomationProperties.Name="Electional"
                            ToolTip.Tip="Electional Astrology (Alt+5)">
                        <StackPanel>
                            <TextBlock Classes="glyph" Text="&#x2605;" />
                            <TextBlock Classes="caption" Text="Election" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsMedicalPanelVisible}"
                            Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Medical}"
                            AutomationProperties.Name="Medical"
                            ToolTip.Tip="Medical Astrology (Alt+6)">
                        <StackPanel>
                            <TextBlock Classes="glyph" Text="&#x2695;" />
                            <TextBlock Classes="caption" Text="Medical" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsMapPanelVisible}"
                            Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Map}"
                            AutomationProperties.Name="Map"
                            ToolTip.Tip="Astrocartography Map (Alt+8)">
                        <StackPanel>
                            <TextBlock Classes="glyph" Text="&#x1F30D;" />
                            <TextBlock Classes="caption" Text="Map" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsExportPanelVisible}"
                            Command="{Binding NavigateToPanelCommand}"
                            CommandParameter="{x:Static vm:NavigationPanel.Export}"
                            AutomationProperties.Name="Export"
                            ToolTip.Tip="Export &amp; Backup (Alt+7)">
                        <StackPanel>
                            <TextBlock Classes="glyph" Text="&#x2913;" />
                            <TextBlock Classes="caption" Text="Export" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════ -->
            <!-- PANEL HOST: ten switchable placeholders  -->
            <!-- ════════════════════════════════════════ -->
            <!--
                The WPF head has no content host: the ten panels are siblings in
                one StackPanel, each toggled by its own Is<Panel>PanelVisible
                binding, and all ten stay in the visual tree. That structure is
                reproduced exactly here — the only change is that the WPF
                Visibility + BoolToVisibilityConverter pair collapses to a direct
                IsVisible bool binding, and the converter disappears.

                Panel bodies are placeholders in this slice; each is replaced by
                its translated markup in a later slice.
            -->
            <!--
                THE RIGHT INSET IS ON THE STACKPANEL, NOT THE SCROLLVIEWER, AND
                IT IS 16 RATHER THAN THE WPF ORIGINAL'S 8. Both departures are
                measured, not stylistic; the WPF head keeps Padding="0,0,8,0"
                and is correct there.

                Why not Padding here. WPF turns a ScrollViewer's Padding into the
                content presenter's MARGIN, so it deflates measure and arrange
                together. Avalonia keeps it as the presenter's own PADDING, and
                ScrollContentPresenter then measures its child at the full
                viewport (350) while arranging it at viewport minus padding
                (342). StackPanel.ArrangeOverride grants each child
                max(finalSize, desired), so every panel settled at
                clamp(widest child's desired width, 342, 350), giving three
                different content widths in one head (Windows: 342 Chart/Synastry/
                Relocation/Export, 348 Transits, 349 Electional, 350 Medical),
                and the Chart panel's flipped 342 -> 350 partway through typing
                a name, dragging every field column with it. A Margin deflates
                measure as well, which collapses all of them to one width and
                removes the data dependence: measured stable at every name
                length from 0 to 60 characters.

                Why 16 and not 8. Fluent's vertical scroll bar OVERLAYS the
                content where WPF's reserves layout space for it. Measured on
                this markup, the bar occupies x=334..350, so 16 px wide, and it is
                identical collapsed and expanded, because expanding thickens the
                thumb inside a constant-width control rather than widening it.
                At an 8 px inset the content is 342 wide and every scrolling
                panel runs 8 px underneath the bar; at 16 the content ends at
                334, exactly flush with the bar's left edge, and no panel is
                overlapped. 16 is therefore the bar's measured width, not a
                doubled 8.

                Cost of the change, measured across all seven translated panels:
                one wrap moves, the Electional panel's first WrapPanel going
                from 4+3 to 3+4 across the same two rows. That follows from
                removing the clamp, not from the choice of 16; an 8 px inset
                produces the identical split.
            -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="10,0,0,0">
                <StackPanel Margin="0,0,16,0">

                    <!--
                        ═══ CHART PANEL ═══
                        Translated from MainWindow.xaml lines 361-682 of the WPF
                        head. Same labels, same field order, same grouping.

                        Three translations here are not mechanical:

                        1. CalendarDatePicker, not DatePicker. Avalonia's
                           DatePicker is the WinUI three-column spinner and its
                           SelectedDate is DateTimeOffset?; CalendarDatePicker is
                           the WPF DatePicker's counterpart in both appearance and
                           type (DateTime?).

                        2. The two AvailableX collections are bound with x:Static.
                           They are `public static` on ChartEntryViewModel, and
                           the WPF markup reaches them through an instance path
                           ({Binding ChartEntry.AvailableHouseSystems}) because
                           WPF's reflection-based binding tolerates that.
                           Compiled bindings emit instance member access, which is
                           a C# error, so the type is named directly.

                        3. DisplayMemberBinding/SelectedValueBinding are evaluated
                           against the ITEM, not against this view's DataType, so
                           each carries its own x:DataType.
                    -->
                    <!--
                        x:Name is here for ChartPanelLayoutTests, which asserts
                        that this panel's six form grids share one label column
                        width. That test selected its grids as "any Grid in the
                        window containing a formLabel", which was an exact proxy
                        only while the Chart panel was the sole user of that
                        class. The saved-charts filter grid added in slice 3 uses
                        formLabel too — faithfully, since the WPF original uses
                        the FormLabel resource for its Type/Sort/From/To labels —
                        so the proxy now over-matches. Naming the panel lets the
                        test scope to what it actually claims.
                    -->
                    <StackPanel x:Name="ChartPanelRoot"
                                IsVisible="{Binding IsChartPanelVisible}">

                        <TextBlock Classes="panelTitle" Text="Natal Chart" />

                        <!-- Chart Subject -->
                        <TextBlock Classes="sectionHeader" Text="Chart Subject" />

                        <!--
                            The label column is 100 across EVERY translated
                            panel's form grids — the six here, Electional's
                            one, and the Transits panel's two. Moved from 84 in
                            slice 5, the slice that brought the governing label
                            into this head.

                            The number is set by the widest label in the
                            translated set, which is NOT in this panel:
                            "Progressions" (Transits). The column has to hold
                            the label's left bearing, its ink, and the 8 px
                            right margin the formLabel style reserves:

                              Windows / Segoe UI SemiBold 14
                                          1 + 80.8 + 8  = ~90 px
                              macOS   / Helvetica 700
                                          96.5–97.5 px  (measured directly with
                                                         the SkiaSharp harness)

                            100 clears both: ~10 px of slack on Windows, 2.5–3.5
                            on macOS. This panel's own widest label, "UTC
                            Offset", needs only 77 (Windows) / 81 (macOS) and no
                            longer governs anything.

                            THE FONT SIZES ARE RESOLVED, NOT ASSUMED. This head
                            renders labels at FluentTheme's default of 14 on
                            every platform — theme-pinned, and unaffected by the
                            Windows text-scale setting, which Avalonia ignores.
                            The WPF head pins no size and inherits
                            SystemFonts.MessageFontSize, which is 13 on this
                            machine only because its text scaling is 110%.
                            Sizing anything from a WPF-head measurement without
                            stating that machine's text scale repeats the error
                            that left the original label survey 7.7% low. See
                            "Measurement reconciliation (2026-08-08)" in
                            MACOS_PORT_PLAN.md.

                            HELVETICA, NOT SF. The macOS figures are Helvetica
                            because that is Avalonia's default family on the
                            macOS Skia backend: FontManager.Current
                            .DefaultFontFamily returns it directly, and a glyph
                            raster of "UTC Offset" matched Helvetica pixel for
                            pixel, antialiasing included. This head does not
                            render in the macOS system UI font, and this column
                            is not sized for it. Real SF (.AppleSystemUIFont)
                            measures "UTC Offset" at 75.5 px of ink — 84.5
                            needed, inside 100 unlike the old 84 — but the
                            governing "Progressions" has NEVER been measured
                            under SF. If Avalonia's macOS default family ever
                            becomes the system UI font, re-measure the governor
                            there before trusting this column.

                            THE WIDER PLATFORM GOVERNS, AND THAT IS macOS. A
                            future change to this column must be measured on
                            macOS with the SkiaSharp harness, never projected
                            from Windows figures — the ratio method is retired
                            (MACOS_PORT_PLAN.md, 2026-08-08). History of this
                            value, each step measured after the last one went
                            wrong: 92 (sized under the bundled Inter font), 80
                            (Inter dropped, macOS pressure missed — clipped),
                            84 (slice 2c, macOS-measured for "UTC Offset"),
                            100 (slice 5, governed by "Progressions").

                            The headless ChartPanelLayoutTests cannot substitute
                            for those measurements, and the reason differs by
                            platform. On Windows the headless host renders in
                            Inter — measured: the formLabel's resolved family
                            reads "compositefont:fonts:Inter#Inter, $Default
                            #Inter, $Default" — so it measures a font this
                            application does not use. On macOS headless resolves
                            the same Helvetica the head does, but the suite does
                            not run there. Either way the number it reports is
                            not the number above. See
                            FormLabels_FitInsideTheLabelColumn.

                            Keep the grids in step — within this panel and
                            across panels: they are separate Grids that read as
                            one form, and a column that differs between them
                            shows up immediately as fields that do not line up.
                            LabelColumnAlignmentTests pins every translated
                            panel's grids to one width.
                        -->
                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Name" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding ChartEntry.Name}"
                                     AutomationProperties.Name="Name" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Type" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding EventTypes}"
                                      SelectedValueBinding="{Binding Value, x:DataType=enums:EventTypeDisplayItem}"
                                      DisplayMemberBinding="{Binding DisplayName, x:DataType=enums:EventTypeDisplayItem}"
                                      SelectedValue="{Binding ChartEntry.EventType}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      AutomationProperties.Name="Type" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Gender" />
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{Binding GenderValues}"
                                      SelectedItem="{Binding ChartEntry.Gender}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      AutomationProperties.Name="Gender" />
                        </Grid>

                        <!-- Location -->
                        <TextBlock Classes="sectionHeader" Text="Location" />

                        <Grid ColumnDefinitions="100,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                            <!-- Row 0: Location Lookup -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Lookup" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding ChartEntryLocationSearch.SearchText}"
                                     ToolTip.Tip="Enter city name to search (e.g., Richmond, VA)"
                                     AutomationProperties.Name="Location lookup" />
                            <!--
                                Right margin matches the left, for the same
                                reason as the Now button below: at zero the
                                button's right border was clipped by the panel's
                                content edge and its rounded corner rendered
                                flat.
                            -->
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="Lookup"
                                    Command="{Binding LookupLocationCommand}"
                                    Padding="8,3"
                                    Margin="4,2,4,2"
                                    AutomationProperties.Name="Lookup" />

                            <!-- Row 1: Results Dropdown -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Results" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding ChartEntryLocationSearch.Results}"
                                      SelectedItem="{Binding ChartEntryLocationSearch.SelectedResult}"
                                      IsDropDownOpen="{Binding ChartEntryLocationSearch.IsDropDownOpen, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayName, x:DataType=vm:LocationSearchResult}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="Select a result to fill in coordinates and timezone"
                                      AutomationProperties.Name="Location results" />

                            <!-- Row 2: Latitude -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Latitude" />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding ChartEntry.LatitudeText}"
                                     ToolTip.Tip="Decimal degrees (positive = North)"
                                     AutomationProperties.Name="Latitude" />

                            <!-- Row 3: Longitude -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="Longitude" />
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding ChartEntry.LongitudeText}"
                                     ToolTip.Tip="Decimal degrees (positive = East)"
                                     AutomationProperties.Name="Longitude" />

                            <!-- Row 4: Location Name -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="formLabel" Text="Location" />
                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding ChartEntry.LocationName}"
                                     ToolTip.Tip="City, State/Country"
                                     AutomationProperties.Name="Location name" />
                        </Grid>

                        <!-- Date, Time &amp; Timezone -->
                        <TextBlock Classes="sectionHeader" Text="Date, Time &amp; Timezone" />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Date" />
                            <DockPanel Grid.Row="0" Grid.Column="1">
                                <!--
                                    Width 44 against the WPF markup's 40. The
                                    extra 4 is no longer an Inter compensation —
                                    that font is gone — but the head still renders
                                    its form text a little larger than the WPF
                                    head does, so 40 with zeroed padding is too
                                    tight for the caption here. Measured, not
                                    guessed: see the label-column note above.

                                    The right margin matches the left. With it at
                                    zero the button sat hard against the panel's
                                    content edge and its right border was clipped
                                    away, so the rounded corner rendered flat —
                                    visible on macOS and, once looked for, on
                                    Windows too. The WPF head does not have this
                                    problem at the same position, which is why it
                                    reads as an Avalonia clipping artefact rather
                                    than as a layout mistake carried over.
                                -->
                                <Button DockPanel.Dock="Right"
                                        Content="Now"
                                        Command="{Binding NowCommand}"
                                        Width="44" Padding="0" Margin="5,2,5,2"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Set date and time to now"
                                        AutomationProperties.Name="Now" />
                                <CalendarDatePicker SelectedDate="{Binding ChartEntry.EventDate}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,2" Padding="4,3"
                                                    AutomationProperties.Name="Date" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Time" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding ChartEntry.EventTime}"
                                     ToolTip.Tip="HH:mm:ss (24-hour format)"
                                     AutomationProperties.Name="Time" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Timezone" />
                            <!--
                                AutoCompleteBox, not the editable ComboBox the
                                WPF markup uses. This is the one control in the
                                panel that could not be translated directly, and
                                the reason is specific.

                                The view model filters by replacing the contents
                                of FilteredTimezones in place
                                (ObservableRangeCollection.ReplaceAll), which
                                raises a single Reset. Avalonia's ComboBox does
                                not survive that Reset: it drops SelectedItem and
                                blanks its Text. With Text bound two-way, the
                                blank is then written back, so choosing a zone
                                from the drop-down cleared the field. Binding
                                SelectedItem two-way as WPF does was worse — it
                                closed a feedback loop
                                (SelectedItem -> SelectedTimezone -> TimeZone ->
                                refilter -> Reset -> SelectedItem) that recursed
                                until the process died with a stack overflow.
                                Removing the SelectedItem binding entirely does
                                not help; the blanking is intrinsic to the
                                control. WPF's Selector preserves selection
                                across a Reset, which is why none of this is
                                visible there.

                                AutoCompleteBox is not a Selector and keeps its
                                Text across the Reset. FilterMode="None" is
                                mandatory: its default filter is StartsWith, and
                                intersecting that with the view model's Contains
                                filter would silently hide most matches — "York"
                                would stop finding America/New_York.
                                IsTextCompletionEnabled stays false so the
                                control never rewrites what the user typed.

                                TimezonePickerTests pins the Contains semantics,
                                both write directions, and the completion case
                                that first exposed the Reset behaviour.
                            -->
                            <AutoCompleteBox Grid.Row="2" Grid.Column="1"
                                             ItemsSource="{Binding FilteredTimezones}"
                                             Text="{Binding ChartEntry.TimeZone}"
                                             FilterMode="None"
                                             MinimumPrefixLength="0"
                                             IsTextCompletionEnabled="False"
                                             Classes.invalidTimezone="{Binding !ChartEntry.IsTimezoneValid}"
                                             HorizontalAlignment="Stretch"
                                             Margin="0,2" Padding="4,3"
                                             MaxDropDownHeight="300"
                                             ToolTip.Tip="IANA timezone ID (e.g., America/New_York)"
                                             AutomationProperties.Name="Timezone">
                                <!--
                                    The chevron the four sibling ComboBoxes get
                                    from their control template. Without it this
                                    field reads as a plain text box, and nothing
                                    tells the user it has a drop-down at all.

                                    Copied from the Fluent ComboBox template
                                    rather than invented: that template's glyph
                                    is a PathIcon named DropDownGlyph, 12x12,
                                    filled with ComboBoxDropDownGlyphForeground,
                                    and this is the same geometry. The brush is
                                    taken by DynamicResource so the two stay in
                                    step if the theme changes.

                                    It opens the list, as the ComboBoxes' chevrons
                                    do (O-8, H-01): a ToggleButton whose IsChecked
                                    is bound two-way to this box's own
                                    IsDropDownOpen, so a click opens the list, a
                                    second click closes it, and the list closing
                                    any other way (a choice, Escape, a click
                                    elsewhere) releases the toggle. No
                                    code-behind; the look is the
                                    ToggleButton.timezoneChevron style's. Until
                                    1.3.4 the glyph was decoration that ignored
                                    the pointer, and the list opened only on
                                    typing. A ToggleButton, not a Button: the
                                    panels' button counts leave toggles out.
                                -->
                                <AutoCompleteBox.InnerRightContent>
                                    <ToggleButton Classes="timezoneChevron"
                                                  IsChecked="{Binding $parent[AutoCompleteBox].IsDropDownOpen, Mode=TwoWay}"
                                                  ToolTip.Tip="Show the time-zone list"
                                                  AutomationProperties.Name="Show time zones">
                                        <PathIcon Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z"
                                                  Width="12"
                                                  Height="12"
                                                  Margin="0,0,9,0"
                                                  Foreground="{DynamicResource ComboBoxDropDownGlyphForeground}" />
                                    </ToggleButton>
                                </AutoCompleteBox.InnerRightContent>
                            </AutoCompleteBox>

                            <!-- Resolved UTC offset display (read-only, auto-computed) -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="Offset" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding ChartEntry.ResolvedOffsetDisplay, Mode=OneWay}"
                                       Margin="0,4" Padding="4,3"
                                       FontWeight="SemiBold"
                                       Foreground="#1B4F72"
                                       ToolTip.Tip="The UTC offset that will be applied for this timezone and date. Verify this is correct — for historical charts (pre-1966), the IANA timezone database may apply the wrong DST rule." />

                            <!-- Explicit UTC offset override (for historical charts) -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="formLabel" Text="Override" />
                            <CheckBox Grid.Row="4" Grid.Column="1"
                                      IsChecked="{Binding ChartEntry.UseExplicitOffset}"
                                      Content="Use explicit UTC offset (historical charts)"
                                      Margin="0,4"
                                      ToolTip.Tip="Check this for pre-1966 dates where DST status is known from the birth record"
                                      AutomationProperties.Name="Use explicit UTC offset" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Classes="formLabel" Text="UTC Offset" />
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding ChartEntry.UtcOffsetHoursText}"
                                     IsEnabled="{Binding ChartEntry.UseExplicitOffset}"
                                     ToolTip.Tip="UTC offset in hours (e.g., -5 for EST, -4 for EDT, 1 for CET)"
                                     AutomationProperties.Name="UTC Offset" />
                        </Grid>

                        <!-- Houses -->
                        <TextBlock Classes="sectionHeader" Text="Houses" />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="System" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ChartEntryViewModel.AvailableHouseSystems}"
                                      SelectedItem="{Binding ChartEntry.SelectedHouseSystem}"
                                      DisplayMemberBinding="{Binding Converter={StaticResource DisplayTextConverter}, x:DataType=enums:HouseSystem}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="House system for chart calculation. Placidus is the default. Use Equal or Whole Sign for unknown birth times or extreme latitudes."
                                      AutomationProperties.Name="Houses" />

                            <!-- Row 1: the session's minor-points switch (1.6.0, branch AsteroidsPanel). Ticking or
                                 unticking it recasts the Chart panel's chart; it is never saved with the chart. -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Points" />
                            <CheckBox Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding ChartEntry.IncludeMinorPoints}"
                                      Content="Include asteroids and Lilith"
                                      Margin="0,4"
                                      ToolTip.Tip="Ceres, Pallas, Juno, Vesta and Black Moon Lilith (the mean apogee) in every report that carries them this session; not saved with the chart."
                                      AutomationProperties.Name="Include asteroids and Lilith" />
                        </Grid>

                        <!-- Notes -->
                        <TextBlock Classes="sectionHeader" Text="Notes" />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Source" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding ChartEntry.SourceNotes}"
                                     ToolTip.Tip="Data source (e.g., birth certificate, from memory)"
                                     AutomationProperties.Name="Source" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Notes" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding ChartEntry.Notes}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="50"
                                     VerticalAlignment="Top"
                                     AutomationProperties.Name="Notes" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Keywords" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding ChartEntry.Keywords}"
                                     ToolTip.Tip="Comma-separated keywords for categorisation (e.g., celebrity, politician, family)"
                                     AutomationProperties.Name="Keywords" />
                        </Grid>

                        <!-- Horary Question (visible only when EventType is Horary) -->
                        <StackPanel IsVisible="{Binding ChartEntry.IsHorary}">

                            <TextBlock Classes="sectionHeader" Text="Horary Question" />

                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">

                                <!-- Row 0: Category -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Category" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{x:Static vm:ChartEntryViewModel.AvailableHoraryCategories}"
                                          SelectedItem="{Binding ChartEntry.HoraryCategory}"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,2" Padding="4,3"
                                          ToolTip.Tip="Select the question category to determine which house governs the quesited matter"
                                          AutomationProperties.Name="Horary category" />

                                <!-- Row 1: Question -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Question"
                                           VerticalAlignment="Top"
                                           Margin="0,6,8,0" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Classes="formTextBox"
                                         Text="{Binding ChartEntry.HoraryQuestion}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="60"
                                         VerticalAlignment="Top"
                                         ToolTip.Tip="The horary question. First line is the question; additional lines provide context."
                                         AutomationProperties.Name="Horary question" />

                                <!-- Row 2: Set to Now button -->
                                <Button Grid.Row="2" Grid.Column="1"
                                        Content="Set to Now"
                                        Command="{Binding SetToNowCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0"
                                        Padding="10,3"
                                        ToolTip.Tip="Set the date and time to right now (horary charts use the moment of the question)"
                                        AutomationProperties.Name="Set to Now" />
                            </Grid>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <TextBlock Classes="sectionHeader" Text="Actions" />

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Calculate &amp; Save"
                                    Command="{Binding CalculateAndSaveCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Calculate and Save" />
                            <Button Content="Save Markdown"
                                    Command="{Binding ExportMarkdownCommand}"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Export the currently calculated chart as a Markdown file"
                                    AutomationProperties.Name="Save Markdown" />
                            <Button Content="Clear"
                                    Command="{Binding ClearFormCommand}"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Clear" />
                        </WrapPanel>

                    </StackPanel>

                    <!--
                        Synastry & Composite. Translated from MainWindow.xaml
                        685-797. Two sections in the WPF order, same text, same
                        ten interactive controls.

                        BOTH FORM GRIDS MOVE 80 -> 100. The WPF originals still
                        declare Width="80" (xaml:699, :759) because the column
                        move in slice 5 only touched panels that had already been
                        translated. 100 is the settled shared value and both
                        grids are registered in LabelColumnAlignmentTests.

                        The widest label here is "Relationship", and it is worth
                        recording why it is safe: 78.273 advance / 76.456 ink at
                        this head's 14 DIP, so it needs 84.7-86.3 against the
                        shared 100 — 13.7 px of slack. It does NOT displace
                        "Progressions" (87.4-88.8) as the governor, so the column
                        does not move. In the WPF head it is a different story:
                        at 13 DIP it needs 72.68 into the 72 px that an 80 px
                        column leaves after the formLabel's 8 px margin, and the
                        running head reports its slot as 73 where every other
                        label in both panels clamps to 72 — the same overflow
                        signature that identified the Transits panel's clipped
                        "Progressions". That is a pre-existing WPF defect, left
                        alone, and 100 clears it here.

                        TWO CANCEL BUTTONS, distinguished only by their
                        CommandParameter strings. Same shape as the Transits
                        panel's pair: CancelCommand's CanExecute is
                        CanCancel(parameter as string), which falls back to
                        HasActiveOperation when the key is null or blank, so a
                        dropped or misspelled parameter does not break the
                        binding — it silently makes the button track ANY running
                        operation and offer to cancel something it cannot. Both
                        are asserted against MainViewModel.OperationKeys rather
                        than repeated literals, so markup and registry cannot
                        drift apart.

                        ComboBox: DisplayMemberPath has no Avalonia counterpart;
                        DisplayMemberBinding replaces it and needs its own
                        x:DataType because the compiled-binding context inside an
                        item template is the item, not the view model. Every
                        ComboBox also carries HorizontalAlignment="Stretch" —
                        without it Avalonia auto-sizes them and they hug the left
                        of the field column instead of filling it.
                    -->
                    <StackPanel x:Name="SynastryPanelRoot"
                                IsVisible="{Binding IsSynastryPanelVisible}">

                        <TextBlock Classes="panelTitle" Text="Synastry &amp; Composite" />

                        <!-- ── Synastry ── -->
                        <TextBlock Classes="sectionHeader" Text="Synastry" />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">

                            <!-- Row 0: Person B -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Person B" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding AllSavedCharts}"
                                      SelectedItem="{Binding Synastry.PersonB}"
                                      DisplayMemberBinding="{Binding Name, x:DataType=data:ChartEntity}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="Select a saved chart as Person B for synastry comparison"
                                      AutomationProperties.Name="Person B" />

                            <!-- Row 1: Relationship -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Relationship" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding Synastry.RelationshipTypes}"
                                      DisplayMemberBinding="{Binding Converter={StaticResource DisplayTextConverter}, x:DataType=enums:RelationshipType}"
                                      SelectedItem="{Binding Synastry.SelectedRelationshipType}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="Type of relationship for synastry interpretation context"
                                      AutomationProperties.Name="Relationship type" />

                            <!-- Row 2: Relationship Notes -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Rel. Notes" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Synastry.RelationshipNotes}"
                                     ToolTip.Tip="e.g., married 15 years, business partners since 2010"
                                     AutomationProperties.Name="Relationship notes" />
                        </Grid>

                        <!--
                            Screened: requirement 253.5 px of 350 available
                            (72.4%) for Calculate + Cancel, so the row holds two
                            and wraps "Export Synastry MD" to a second line —
                            2+1, matching the WPF head measured at 245.2 of 342.
                        -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Classes="action export"
                                    Content="Calculate Synastry"
                                    Command="{Binding CalculateSynastryCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Calculate Synastry" />
                            <Button Classes="action"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="synastry"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the running synastry calculation"
                                    AutomationProperties.Name="Cancel Synastry" />
                            <Button Classes="action"
                                    Content="Export Synastry MD"
                                    Command="{Binding ExportSynastryMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Synastry MD" />
                        </WrapPanel>

                        <!-- ── Composite Chart ── -->
                        <TextBlock Classes="sectionHeader" Text="Composite Chart" />

                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF888888"
                                   Margin="0,0,0,4"
                                   Text="Uses the Person B selected in Synastry above. Calculate a natal chart first, then select Person B." />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Context"
                                       VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Synastry.CompositeInterpretationContext}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"
                                     VerticalContentAlignment="Top"
                                     ToolTip.Tip="Optional context for AI interpretation (e.g., relationship history, focus areas)"
                                     AutomationProperties.Name="Composite context" />
                        </Grid>

                        <!--
                            Screened: 268.0 px of 350 (76.6%) for Calculate +
                            Cancel — 2+1, matching WPF's 258.7 of 342.
                        -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Classes="action export"
                                    Content="Calculate Composite"
                                    Command="{Binding CalculateCompositeCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Calculate Composite" />
                            <Button Classes="action"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="composite"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the running composite calculation"
                                    AutomationProperties.Name="Cancel Composite" />
                            <Button Classes="action"
                                    Content="Export Composite MD"
                                    Command="{Binding ExportCompositeMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Composite MD" />
                        </WrapPanel>

                        <!--
                            ── Davison Chart ── (branch DavisonPanel, 1.7.0): the
                            Composite section's twin for the same two charts, a
                            real chart cast for the midpoint moment at the
                            midpoint place; shown and exported only.
                        -->
                        <TextBlock Classes="sectionHeader" Text="Davison Chart" />

                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF888888"
                                   Margin="0,0,0,4"
                                   Text="A real chart cast for the midpoint of the two births, in time and place; the same two charts as the synastry above." />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Context"
                                       VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Synastry.DavisonInterpretationContext}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"
                                     VerticalContentAlignment="Top"
                                     ToolTip.Tip="Optional context for AI interpretation (e.g., relationship history, focus areas)"
                                     AutomationProperties.Name="Davison context" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Classes="action export"
                                    Content="Calculate Davison"
                                    Command="{Binding CalculateDavisonCommand}"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cast the Davison chart of the Chart panel's chart and Person B: the midpoint moment at the midpoint place."
                                    AutomationProperties.Name="Calculate Davison" />
                            <Button Classes="action"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="davison"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the running Davison calculation"
                                    AutomationProperties.Name="Cancel Davison" />
                            <Button Classes="action"
                                    Content="Export Davison MD"
                                    Command="{Binding ExportDavisonMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Export the Davison chart, complete, as Markdown."
                                    AutomationProperties.Name="Export Davison MD" />
                        </WrapPanel>

                    </StackPanel>

                    <!--
                        Transits panel. Translated from MainWindow.xaml 800-958.

                        Three features share this panel, exactly as in the WPF
                        head: Transits (dates, four toggles, context, four
                        buttons), Daily Horoscope (one export button fed by the
                        transit result above), and the Return &amp; Ingress
                        Timeline (years, two toggles, three buttons). The
                        timeline section binds ReturnIngressTimeline.*, a
                        different child view model from Transits.* — the WPF
                        panel hosts both and so does this one.

                        Screened with the settled technique before translation
                        (layout extent vs a stretched sibling, both window
                        heights, running WPF head): the Transits button row
                        needed 519 px and wrapped 2+2 in WPF at every height;
                        this head computed 544 against 326 and wrapped 2+2 as
                        well. The timeline button row needs 352 (WPF, 2+1 at
                        every height) and 360 here (2+1). The checkbox row and
                        the single Daily Horoscope button fit one row in both.
                        Identical wrap throughout — measured in WPF, computed
                        directly for this head (14 x unit advance + chrome,
                        never projected), and confirmed from the running app
                        after translation.

                        Since 1.4.0 (branch ModesPanel) the Transits row reads
                        Calculate, Cancel, Export Report MD, Export Timeline MD.
                        Measured on macOS, from the running app's accessibility
                        frames at the default 950 x 600 window: 100, 100, 138.5
                        and 148.5 px, 511 with the four 6 px margins, against
                        the panel's 334. Calculate and Cancel take 212, and
                        Export Report MD would bring the line to 356.5, so the
                        row wraps 2+2. WPF, from its markup (Padding 12,5, a
                        1 px border, MinWidth 100, the 6 px margins) and each
                        caption's Segoe UI advance at 13 DIP, the size the
                        recorded WPF widths imply (the same sum gives the old
                        row 519.5 for the measured 519): 100, 100, 129.8 and
                        139.4, 493.2 against 342. Export Report MD would bring
                        the first line to 347.8, so WPF wraps 2+2 as well, by
                        5.8 px: the tightest line in the panel, and the first
                        to check on Windows.

                        Label column is the shared 100. The governing label of
                        the whole translated set, "Progressions", is in THIS
                        panel — the first time it exists in this head. Its row
                        carries the note.
                    -->
                    <StackPanel x:Name="TransitsPanelRoot"
                                IsVisible="{Binding IsTransitsPanelVisible}">
                        <TextBlock Classes="panelTitle" Text="Transits &amp; Progressions" />

                        <TextBlock Classes="sectionHeader" Text="Transits" />

                        <Grid ColumnDefinitions="100,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                            <!-- Row 0: Start Date -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Start Date" />
                            <CalendarDatePicker Grid.Row="0" Grid.Column="1"
                                                SelectedDate="{Binding Transits.StartDate}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,2" Padding="4,3"
                                                ToolTip.Tip="First day of the transit report window"
                                                AutomationProperties.Name="Transit start date" />

                            <!-- Row 1: End Date -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="End Date" />
                            <CalendarDatePicker Grid.Row="1" Grid.Column="1"
                                                SelectedDate="{Binding Transits.EndDate}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,2" Padding="4,3"
                                                ToolTip.Tip="Last day of the transit report window"
                                                AutomationProperties.Name="Transit end date" />

                            <!--
                                Rows 2 to 6: the four techniques the report runs,
                                each its own box since 1.4.0 (branch ModesPanel;
                                until then one Progressions box drove the solar
                                arcs and the progressions both), Directions since
                                1.5.0 (branch PrimaryPanel), which takes the
                                Directions panel's settings. Calculate needs at
                                least one checked. Minor follows Transits: the
                                minor aspects are the transits' only, so the box
                                is disabled while Transits is unchecked, and its
                                tooltip shows while it is disabled.
                            -->
                            <!-- Row 2: Transits -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Transits" />
                            <CheckBox Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding Transits.IncludeTransits}"
                                      Content="Include transits"
                                      Margin="0,4"
                                      ToolTip.Tip="Include the transits: the transiting planets' aspects to the natal chart, their stations and ingresses, the house overlays and the midpoint activations"
                                      AutomationProperties.Name="Include transits" />

                            <!-- Row 3: Minor aspects -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="Minor" />
                            <CheckBox Grid.Row="3" Grid.Column="1"
                                      IsChecked="{Binding Transits.IncludeMinorAspects}"
                                      IsEnabled="{Binding Transits.IncludeTransits}"
                                      Content="Include minor aspects"
                                      Margin="0,4"
                                      ToolTip.Tip="Transits only: include the semi-square, sesquiquadrate, semi-sextile and quincunx"
                                      ToolTip.ShowOnDisabled="True"
                                      AutomationProperties.Name="Include minor aspects" />

                            <!-- Row 4: Solar arc directions -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="formLabel" Text="Solar Arc" />
                            <CheckBox Grid.Row="4" Grid.Column="1"
                                      IsChecked="{Binding Transits.IncludeSolarArcs}"
                                      Content="Include solar arc directions"
                                      Margin="0,4"
                                      ToolTip.Tip="Include the solar arc directions: the directed positions and their aspects at the start, and the dated hits in the period"
                                      AutomationProperties.Name="Include solar arc directions" />

                            <!--
                                Row 5: Progressions. This label is the widest in
                                every translated panel — the governor the 100 px
                                column is sized for: ~90 px on Windows at the
                                theme-pinned 14, 96.5-97.5 px on macOS. If it is
                                ever renamed or the column narrowed, re-derive at
                                the Chart panel's first form grid.
                            -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Classes="formLabel" Text="Progressions" />
                            <CheckBox Grid.Row="5" Grid.Column="1"
                                      IsChecked="{Binding Transits.IncludeSecondaryProgressions}"
                                      Content="Include secondary progressions"
                                      Margin="0,4"
                                      ToolTip.Tip="Include the secondary progressions: the progressed positions, Moon, stations and aspects at the start, and the dated hits in the period"
                                      AutomationProperties.Name="Include secondary progressions" />

                            <!-- Row 6: Primary directions (1.5.0, branch PrimaryPanel) -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Classes="formLabel" Text="Directions" />
                            <CheckBox Grid.Row="6" Grid.Column="1"
                                      IsChecked="{Binding Transits.IncludePrimaryDirections}"
                                      Content="Include primary directions"
                                      Margin="0,4"
                                      ToolTip.Tip="Include the primary directions exact in the period, found with the Directions panel's settings"
                                      AutomationProperties.Name="Include primary directions" />

                            <!-- Row 7: Interpretation context -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Classes="formLabel" Text="Context"
                                       VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox Grid.Row="7" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Transits.InterpretationContext}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"
                                     VerticalContentAlignment="Top"
                                     ToolTip.Tip="Optional context for AI interpretation (e.g., Focus on career themes)"
                                     AutomationProperties.Name="Interpretation context" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate"
                                    Command="{Binding CalculateTransitCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Calculate the report for the checked techniques over the dates above. Needs a chart on the Chart panel and at least one of Transits, Solar Arc, Progressions and Directions checked; Directions takes the Directions panel's settings."
                                    ToolTip.ShowOnDisabled="True"
                                    AutomationProperties.Name="Calculate" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="transits"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Transits calculation"
                                    AutomationProperties.Name="Cancel Transits" />
                            <Button Content="Export Report MD"
                                    Command="{Binding ExportTransitMarkdownCommand}"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Export the report as Markdown, titled for the techniques it holds"
                                    AutomationProperties.Name="Export Report MD" />
                            <Button Content="Export Timeline MD"
                                    Command="{Binding ExportTransitTimelineMarkdownCommand}"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Export a chronological transit event timeline as Markdown. Needs a result with transits."
                                    ToolTip.ShowOnDisabled="True"
                                    AutomationProperties.Name="Export Timeline MD" />
                        </WrapPanel>

                        <TextBlock Classes="sectionHeader" Text="Daily Horoscope" />
                        <TextBlock Text="Generates a per-day transit digest from the calculated transit data above. Uses the same date range and natal chart."
                                   FontSize="10" Foreground="#FF888888" TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Export Daily Horoscope MD"
                                    Command="{Binding ExportDailyHoroscopeMarkdownCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Export a per-day transit digest as Markdown for AI interpretation. Needs a result with transits."
                                    ToolTip.ShowOnDisabled="True"
                                    AutomationProperties.Name="Export Daily Horoscope MD" />
                        </WrapPanel>

                        <Separator Margin="0,12,0,8" />

                        <TextBlock Classes="sectionHeader" Text="Return &amp; Ingress Timeline" />

                        <Grid ColumnDefinitions="100,*,*">
                            <TextBlock Grid.Column="0" Classes="formLabel" Text="Years" />
                            <TextBox Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding ReturnIngressTimeline.StartYear}"
                                     Margin="0,2,4,2"
                                     ToolTip.Tip="Start year"
                                     AutomationProperties.Name="Timeline start year" />
                            <TextBox Grid.Column="2"
                                     Classes="formTextBox"
                                     Text="{Binding ReturnIngressTimeline.EndYear}"
                                     Margin="0,2,0,2"
                                     ToolTip.Tip="End year"
                                     AutomationProperties.Name="Timeline end year" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <CheckBox Content="Returns"
                                      IsChecked="{Binding ReturnIngressTimeline.IncludeReturns}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip.Tip="Include planetary returns to natal positions (Mercury-Saturn)"
                                      AutomationProperties.Name="Include returns" />
                            <CheckBox Content="Ingresses"
                                      IsChecked="{Binding ReturnIngressTimeline.IncludeIngresses}"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Include outer planet sign ingresses (Jupiter-Pluto + Chiron)"
                                      AutomationProperties.Name="Include ingresses" />
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button Content="Calculate Timeline"
                                    Command="{Binding CalculateRITimelineCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Calculate all returns and ingresses in the date range"
                                    AutomationProperties.Name="Calculate Timeline" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="returnIngressTimeline"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Return / Ingress Timeline calculation"
                                    AutomationProperties.Name="Cancel Timeline" />
                            <Button Content="Export MD"
                                    Command="{Binding ExportRITimelineCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export RI Timeline MD" />
                        </WrapPanel>

                    </StackPanel>

                    <!--
                        Returns. Translated from MainWindow.xaml 959-1596 — 638
                        lines, the largest single translation in the port, and
                        the last of the nine panels the port translated.

                        TEN OPERABLE SECTIONS, NOT FIVE. Solar Return, Lunar
                        Return, Planetary Return (with its cycle timeline),
                        Mundane Location, Great Conjunctions, Synodic Cycles,
                        Ingress Charts, Lunation Charts, Eclipse Calculator and
                        Mundane Aspect Finder, plus a display-only Annual
                        Profection block gated on Returns.HasProfection. 36
                        buttons, 11 export commands and TWELVE Cancel buttons.

                        THREE BINDING ROOTS, and they do NOT line up with the
                        visual sections. "Include snapshots" sits inside
                        Planetary Return but binds Cycles.IncludeCycleSnapshots;
                        Great Conjunctions and Synodic Cycles are Cycles;
                        Ingress / Lunation / Eclipse / Mundane Aspects are
                        Mundane. A reader expecting Returns.* throughout would
                        be wrong four sections out of ten.

                        THREE OPTION COLLECTIONS ARE static AND NEED x:Static.
                        ReturnsViewModel.AvailableReturnPlanets,
                        ReturnsViewModel.AvailableReturnFindModes and
                        MundaneViewModel.AvailableIngressPlanets are static
                        properties. WPF's reflection binding tolerates
                        {Binding Returns.AvailableReturnPlanets}; compiled
                        bindings emit instance access and fail to compile. The
                        other three (Cycles.SynodicBodyOptions,
                        Mundane.AvailableHarmonicModes,
                        Mundane.AvailableMundanePlanets) are instance
                        properties and bind normally — the split is per
                        property, not per view model.

                        TEN GRIDS MOVE 80 -> 100, the shared label column. The
                        widest label here is "Start Date" at 72.6 needed (64.6
                        ink + 8 margin) against 100; "Progressions" in the
                        Transits panel remains the global governor at 89.1.

                        THE MUNDANE LOOKUP BUTTON IS THE ONLY STYLED Lookup IN
                        THE APP. Chart's (xaml:522) and Electional's (xaml:1900)
                        carry no style; this one carries ExportButton, so it
                        renders blue, SemiBold and 100 px wide. Its Width="55"
                        is inert for the reason recorded on the Relocation Find
                        button — MinWidth="100" clamps it up, and the shipped
                        WPF head renders it at 100 (measured on glass at
                        x=369..469). Carried faithfully because it is
                        identically dead on both sides.

                        AND THAT ROW HAS NO Enter BINDING. Electional's search
                        box binds Enter to its lookup command; Chart's and this
                        one do not, in WPF. Not adding one.

                        TWELVE CANCELS NEED TWELVE AUTOMATION NAMES. The caption
                        is "Cancel" twelve times over, "Export MD" three times
                        and "Find Conjunctions" twice, so no test can find a
                        button by its caption. Every Cancel is named "Cancel
                        <section>". The cycle-timeline pair is additionally
                        renamed away from the Transits panel's "Calculate
                        Timeline" / "Cancel Timeline", which share this panel's
                        captions but not its commands.

                        CommandParameter STRINGS ARE INVISIBLE TO COMPILED
                        BINDINGS, so the twelve operation keys are unchecked by
                        the compiler in both heads. CanCancel (MainViewModel.cs
                        :1605) returns HasActiveOperation for a blank key and
                        IsOperationActive(key) otherwise, so a typo degrades a
                        Cancel into "cancel anything" and a swap silently
                        cancels the wrong operation — both build and both pass
                        every other test. ReturnsPanelTests asserts all twelve
                        against MainViewModel.OperationKeys BY REFERENCE and
                        asserts they are twelve DISTINCT constants.
                    -->
                    <StackPanel x:Name="ReturnsPanelRoot"
                                IsVisible="{Binding IsReturnsPanelVisible}">

                        <TextBlock Classes="panelTitle" Text="Returns" />

                        <!-- Annual Profection: display only, no interaction. -->
                        <StackPanel IsVisible="{Binding Returns.HasProfection}"
                                    Margin="0,0,0,8">
                            <TextBlock Classes="sectionHeader" Text="Annual Profection" />
                            <TextBlock Text="{Binding Returns.ProfectionSummary}"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="#FF1B4F72" FontWeight="SemiBold"
                                       Margin="0,2,0,4" />
                            <TextBlock Text="{Binding Returns.FirdariaSummary}"
                                       TextWrapping="Wrap" FontSize="10"
                                       Foreground="#FF666666" Margin="0,1,0,1"
                                       IsVisible="{Binding Returns.HasProfection}" />
                            <TextBlock Text="{Binding Returns.ZodiacalReleasingSummary}"
                                       TextWrapping="Wrap" FontSize="10"
                                       Foreground="#FF666666" Margin="0,1,0,4"
                                       IsVisible="{Binding Returns.HasProfection}" />
                        </StackPanel>

                        <!-- ── Solar Return ─────────────────────── -->
                        <TextBlock Classes="sectionHeader" Text="Solar Return" />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Year" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Returns.SolarReturnYear}"
                                     ToolTip.Tip="Year for solar return (e.g., 2026). Uses natal chart location."
                                     AutomationProperties.Name="Solar return year" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Context"
                                       VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Returns.SolarReturnInterpretationContext}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"
                                     VerticalContentAlignment="Top"
                                     ToolTip.Tip="Optional context for AI interpretation (e.g., life situation, annual focus)"
                                     AutomationProperties.Name="Solar return context" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate Solar Return"
                                    Command="{Binding CalculateSolarReturnCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Calculate Solar Return" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="solarReturn"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the running solar return calculation"
                                    AutomationProperties.Name="Cancel solar return" />
                            <Button Content="Export Solar Return MD"
                                    Command="{Binding ExportSolarReturnMarkdownCommand}"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Solar Return MD" />
                        </WrapPanel>

                        <!-- ── Lunar Return ─────────────────────── -->
                        <TextBlock Classes="sectionHeader" Text="Lunar Return" />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Start Date" />
                            <CalendarDatePicker Grid.Row="0" Grid.Column="1"
                                                SelectedDate="{Binding Returns.LunarReturnStartDate}"
                                                Margin="0,2" Padding="4,3"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="First day of the lunar return search window"
                                                AutomationProperties.Name="Lunar return start date" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="End Date" />
                            <CalendarDatePicker Grid.Row="1" Grid.Column="1"
                                                SelectedDate="{Binding Returns.LunarReturnEndDate}"
                                                Margin="0,2" Padding="4,3"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Last day of the lunar return search window"
                                                AutomationProperties.Name="Lunar return end date" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Context"
                                       VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Returns.LunarReturnInterpretationContext}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="60"
                                     VerticalContentAlignment="Top"
                                     ToolTip.Tip="Optional context for AI interpretation (e.g., current concerns, monthly focus)"
                                     AutomationProperties.Name="Lunar return context" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="Results" />
                            <ComboBox Grid.Row="3" Grid.Column="1"
                                      ItemsSource="{Binding Returns.LunarReturnResults}"
                                      SelectedItem="{Binding Returns.SelectedLunarReturn}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="Select a lunar return to export"
                                      AutomationProperties.Name="Lunar return results">
                                <ComboBox.ItemTemplate>
                                    <!--
                                        The only MultiBinding in this head that
                                        carries a FORMAT SPECIFIER. The existing
                                        one (saved-charts pane, below) formats
                                        three bare values; this one formats a
                                        DateTime as yyyy-MM-dd HH:mm. Verified
                                        against the running head rather than
                                        assumed.
                                    -->
                                    <DataTemplate x:DataType="models:LunarReturnResult">
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="#{0} — {1:yyyy-MM-dd HH:mm} UTC">
                                                    <Binding Path="SequenceNumber" />
                                                    <Binding Path="ReturnChart.Input.LocalDateTime" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Calculate Lunar Returns"
                                    Command="{Binding CalculateLunarReturnCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Calculate Lunar Returns" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="lunarReturn"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Lunar Return calculation"
                                    AutomationProperties.Name="Cancel lunar return" />
                            <Button Content="Export Lunar Return MD"
                                    Command="{Binding ExportLunarReturnMarkdownCommand}"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Lunar Return MD" />
                        </WrapPanel>

                        <!-- ── Planetary Return ─────────────────── -->
                        <TextBlock Classes="sectionHeader" Text="Planetary Return" />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto">

                            <!-- Row 0: Planet -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Planet" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ReturnsViewModel.AvailableReturnPlanets}"
                                      SelectedItem="{Binding Returns.SelectedReturnPlanet}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="Select the planet for the return chart"
                                      AutomationProperties.Name="Planetary return planet" />

                            <!-- Row 1: Find Mode -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Find by" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ReturnsViewModel.AvailableReturnFindModes}"
                                      SelectedItem="{Binding Returns.SelectedReturnFindMode}"
                                      DisplayMemberBinding="{Binding Converter={StaticResource DisplayTextConverter}, x:DataType=vm:ReturnFindMode}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="By Year: find the return nearest to a year. By Return #: find the Nth return."
                                      AutomationProperties.Name="Planetary return find mode" />

                            <!--
                                Row 2 holds FOUR controls in one cell, two of
                                which are visible at a time. WPF swaps the
                                Return # pair and the Year pair on
                                IsReturnByNumber / IsReturnByYear; both pairs sit
                                on Grid.Row="2". Kept as-is rather than split
                                into two rows, because collapsing to two rows
                                would leave an empty row in whichever mode is
                                inactive and move everything below it.
                            -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Return #"
                                       IsVisible="{Binding Returns.IsReturnByNumber}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Returns.ReturnNumber}"
                                     IsVisible="{Binding Returns.IsReturnByNumber}"
                                     ToolTip.Tip="Return number (1 = first return, 2 = second, etc.)"
                                     AutomationProperties.Name="Planetary return number" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Year"
                                       IsVisible="{Binding Returns.IsReturnByYear}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Returns.ReturnYear}"
                                     IsVisible="{Binding Returns.IsReturnByYear}"
                                     ToolTip.Tip="Target year — finds the return nearest to mid-year"
                                     AutomationProperties.Name="Planetary return year" />

                            <!-- Row 3: Context -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="Context"
                                       VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Returns.PlanetaryReturnInterpContext}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="50"
                                     VerticalContentAlignment="Top"
                                     ToolTip.Tip="Optional interpretation context"
                                     AutomationProperties.Name="Planetary return context" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <Button Content="Calculate Return"
                                    Command="{Binding CalculatePlanetaryReturnCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Calculate Return" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="planetaryReturn"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Planetary Return calculation"
                                    AutomationProperties.Name="Cancel planetary return" />
                            <Button Content="Export Return MD"
                                    Command="{Binding ExportPlanetaryReturnMarkdownCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Return MD" />
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <CheckBox Content="Include snapshots"
                                      IsChecked="{Binding Cycles.IncludeCycleSnapshots}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      ToolTip.Tip="Include planetary position snapshots at each phase point"
                                      AutomationProperties.Name="Include snapshots" />
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <Button Content="Calculate Timeline"
                                    Command="{Binding CalculateCycleTimelineCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Calculate the full cycle between this return and the next"
                                    AutomationProperties.Name="Calculate Cycle Timeline" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="planetaryCycle"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Planetary Cycle Timeline calculation"
                                    AutomationProperties.Name="Cancel cycle timeline" />
                            <Button Content="Export Timeline MD"
                                    Command="{Binding ExportCycleTimelineMarkdownCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Cycle Timeline MD" />
                        </WrapPanel>

                        <!-- ── Mundane Location ─────────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Classes="sectionHeader" Text="Mundane Location" />

                        <Grid ColumnDefinitions="100,*,Auto">

                            <TextBlock Grid.Column="0" Classes="formLabel" Text="Search" />
                            <TextBox Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Mundane.LocationSearch.SearchText}"
                                     ToolTip.Tip="Type a city name (e.g., Washington, London, Beijing)"
                                     AutomationProperties.Name="Mundane location lookup" />
                            <Button Grid.Column="2" Content="Lookup"
                                    Command="{Binding LookupMundaneLocationCommand}"
                                    Classes="action export"
                                    Margin="4,2,4,2" Width="55"
                                    AutomationProperties.Name="Lookup mundane location" />
                        </Grid>

                        <ComboBox ItemsSource="{Binding Mundane.LocationSearch.Results}"
                                  SelectedItem="{Binding Mundane.LocationSearch.SelectedResult}"
                                  IsDropDownOpen="{Binding Mundane.LocationSearch.IsDropDownOpen, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName, x:DataType=vm:LocationSearchResult}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,2,0,0" Padding="4,3"
                                  AutomationProperties.Name="Mundane location results" />

                        <TextBlock Text="{Binding Mundane.LocationName}"
                                   FontSize="10" Foreground="#FF1B4F72" FontWeight="SemiBold"
                                   Margin="0,2,0,6" TextWrapping="Wrap" />

                        <!-- ── Great Conjunctions ───────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Classes="sectionHeader" Text="Great Conjunctions" />

                        <Grid ColumnDefinitions="100,*,*" RowDefinitions="Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Years" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Cycles.GCStartYear}"
                                     ToolTip.Tip="Start year" Margin="0,2,4,2"
                                     AutomationProperties.Name="Great conjunctions start year" />
                            <TextBox Grid.Row="0" Grid.Column="2"
                                     Classes="formTextBox"
                                     Text="{Binding Cycles.GCEndYear}"
                                     ToolTip.Tip="End year" Margin="0,2,0,2"
                                     AutomationProperties.Name="Great conjunctions end year" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Find Conjunctions"
                                    Command="{Binding FindGreatConjunctionsCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Find Great Conjunctions" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="greatConjunctions"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Great Conjunctions search"
                                    AutomationProperties.Name="Cancel great conjunctions" />
                            <Button Content="Export Series MD"
                                    Command="{Binding ExportGCSeriesMarkdownCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Great Conjunction Series MD" />
                        </WrapPanel>

                        <!-- ── Synodic Cycles ───────────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Classes="sectionHeader" Text="Synodic Cycles" />

                        <Grid ColumnDefinitions="100,*,*" RowDefinitions="Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Bodies" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding Cycles.SynodicBodyOptions}"
                                      SelectedItem="{Binding Cycles.SynodicBodyA}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2,4,2" Padding="4,3"
                                      ToolTip.Tip="First body (faster-moving)"
                                      AutomationProperties.Name="Synodic body A" />
                            <ComboBox Grid.Row="0" Grid.Column="2"
                                      ItemsSource="{Binding Cycles.SynodicBodyOptions}"
                                      SelectedItem="{Binding Cycles.SynodicBodyB}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2,0,2" Padding="4,3"
                                      ToolTip.Tip="Second body (slower-moving)"
                                      AutomationProperties.Name="Synodic body B" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Years" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Cycles.SynodicStartYear}"
                                     ToolTip.Tip="Start year" Margin="0,2,4,2"
                                     AutomationProperties.Name="Synodic start year" />
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     Classes="formTextBox"
                                     Text="{Binding Cycles.SynodicEndYear}"
                                     ToolTip.Tip="End year" Margin="0,2,0,2"
                                     AutomationProperties.Name="Synodic end year" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Find Conjunctions"
                                    Command="{Binding FindSynodicCyclesCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Find Synodic Cycles" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="synodicCycle"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Synodic Cycle search"
                                    AutomationProperties.Name="Cancel synodic cycles" />
                            <Button Content="Export Series MD"
                                    Command="{Binding ExportSynodicCycleMdCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Synodic Cycle MD" />
                        </WrapPanel>

                        <!-- ── Ingress Charts ───────────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Classes="sectionHeader" Text="Ingress Charts" />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Planet" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{x:Static vm:MundaneViewModel.AvailableIngressPlanets}"
                                      SelectedItem="{Binding Mundane.IngressPlanet}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="Planet to track (Sun for cardinal ingresses)"
                                      AutomationProperties.Name="Ingress planet" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Year" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Mundane.IngressYear}"
                                     ToolTip.Tip="Year to search"
                                     AutomationProperties.Name="Ingress year" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <CheckBox Content="Cardinal only"
                                      IsChecked="{Binding Mundane.CardinalOnly}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip.Tip="Show only equinox/solstice ingresses"
                                      AutomationProperties.Name="Cardinal only" />
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,8">
                            <Button Content="Find Ingresses"
                                    Command="{Binding FindIngressesCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Find ingress dates (timing only)"
                                    AutomationProperties.Name="Find Ingresses" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="ingressSeries"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Ingress search"
                                    AutomationProperties.Name="Cancel ingress series" />
                            <Button Content="Calculate Cardinal Charts"
                                    Command="{Binding CalculateCardinalIngressesCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cast full charts for all 4 cardinal ingresses"
                                    AutomationProperties.Name="Calculate Cardinal Charts" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="cardinalIngresses"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Cardinal Ingress chart calculation"
                                    AutomationProperties.Name="Cancel cardinal ingresses" />
                            <Button Content="Export MD"
                                    Command="{Binding ExportIngressSeriesMarkdownCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Ingress Series MD" />
                            <Button Content="Export Cardinal MD"
                                    Command="{Binding ExportCardinalIngressesMarkdownCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Cardinal Ingresses MD" />
                        </WrapPanel>

                        <!-- ── Lunation Charts ──────────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Classes="sectionHeader" Text="Lunation Charts" />

                        <Grid ColumnDefinitions="100,*">

                            <TextBlock Grid.Column="0" Classes="formLabel" Text="Year" />
                            <TextBox Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Mundane.LunationYear}"
                                     ToolTip.Tip="Year to find all New Moons and Full Moons"
                                     AutomationProperties.Name="Lunation year" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button Content="Find Lunations"
                                    Command="{Binding FindLunationsCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Find all New/Full Moons for the year (timing only)"
                                    AutomationProperties.Name="Find Lunations" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="lunationSeries"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Lunation search"
                                    AutomationProperties.Name="Cancel lunation series" />
                            <Button Content="Calculate Charts"
                                    Command="{Binding CalculateLunationChartsCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cast full charts at all lunations using the mundane location"
                                    AutomationProperties.Name="Calculate Lunation Charts" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="lunationCharts"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Lunation chart calculation"
                                    AutomationProperties.Name="Cancel lunation charts" />
                            <Button Content="Export MD"
                                    Command="{Binding ExportLunationSeriesCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Lunation Series MD" />
                        </WrapPanel>

                        <!-- ── Eclipse Calculator ───────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Classes="sectionHeader" Text="Eclipse Calculator" />

                        <Grid ColumnDefinitions="100,*,*">

                            <TextBlock Grid.Column="0" Classes="formLabel" Text="Years" />
                            <TextBox Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Mundane.EclipseStartYear}"
                                     ToolTip.Tip="Start year" Margin="0,2,4,2"
                                     AutomationProperties.Name="Eclipse start year" />
                            <TextBox Grid.Column="2"
                                     Classes="formTextBox"
                                     Text="{Binding Mundane.EclipseEndYear}"
                                     ToolTip.Tip="End year" Margin="0,2,0,2"
                                     AutomationProperties.Name="Eclipse end year" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button Content="Find Eclipses"
                                    Command="{Binding FindEclipsesCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Find all solar and lunar eclipses in the date range"
                                    AutomationProperties.Name="Find Eclipses" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="eclipses"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Eclipse search"
                                    AutomationProperties.Name="Cancel eclipses" />
                            <Button Content="Export MD"
                                    Command="{Binding ExportEclipseSeriesCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Eclipse Series MD" />
                        </WrapPanel>

                        <!-- ── Mundane Aspect Finder ────────────── -->
                        <Separator Margin="0,12,0,8" />

                        <TextBlock Classes="sectionHeader" Text="Mundane Aspect Finder" />

                        <Grid ColumnDefinitions="100,*,*" RowDefinitions="Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Planet 1" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding Mundane.AvailableMundanePlanets}"
                                      SelectedItem="{Binding Mundane.MABody1}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2,4,2" Padding="4,3"
                                      AutomationProperties.Name="Mundane aspect body 1" />
                            <ComboBox Grid.Row="0" Grid.Column="2"
                                      ItemsSource="{Binding Mundane.AvailableMundanePlanets}"
                                      SelectedItem="{Binding Mundane.MABody2}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2,0,2" Padding="4,3"
                                      AutomationProperties.Name="Mundane aspect body 2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Harmonic" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding Mundane.AvailableHarmonicModes}"
                                      SelectedItem="{Binding Mundane.MAHarmonicMode}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2,0,2" Padding="4,3"
                                      ToolTip.Tip="45° = full Ebertin cycle (8 phases). 90° = major aspects only (4 phases)."
                                      AutomationProperties.Name="Mundane aspect harmonic" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Years" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Mundane.MAStartYear}"
                                     ToolTip.Tip="Start year" Margin="0,2,4,2"
                                     AutomationProperties.Name="Mundane aspect start year" />
                            <TextBox Grid.Row="2" Grid.Column="2"
                                     Classes="formTextBox"
                                     Text="{Binding Mundane.MAEndYear}"
                                     ToolTip.Tip="End year" Margin="0,2,0,2"
                                     AutomationProperties.Name="Mundane aspect end year" />
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button Content="Find Aspects"
                                    Command="{Binding FindMundaneAspectsCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Find all exact aspects between the two bodies"
                                    AutomationProperties.Name="Find Mundane Aspects" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="mundaneAspects"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Mundane Aspects search"
                                    AutomationProperties.Name="Cancel mundane aspects" />
                            <Button Content="Export MD"
                                    Command="{Binding ExportMASeriesCommand}"
                                    Classes="action export"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Mundane Aspect Series MD" />
                        </WrapPanel>

                    </StackPanel>

                    <!--
                        Relocation: one birth chart, then a new place (1.4.0,
                        item 3, branch Relocate). A description line, then two
                        sections in the Chart panel's style, a section header
                        and its grid on the shared label column (100): Birth
                        Chart, the saved-chart picker; New Location, Search
                        with Find, Results, Latitude, Longitude and Location in
                        one grid. Then Calculate, Cancel and Export. The WPF
                        head's Relocation panel has the same rows on its 80
                        column.

                        Until 1.4.0 the panel was one ungrouped form: a "Natal
                        Chart" picker, a grey hint hung under it by a margin
                        copied from the label column, then the place fields in
                        two grids. Every line now sits in a grid's field
                        column, so no margin has to track the column.

                        THE SEARCH ROW IS A THIRD Auto COLUMN, not a DockPanel
                        as in WPF. The rendered result is the same, label, box
                        and button on one line, and the grid form keeps the
                        fix this head made on its other location lookups: at a
                        zero right margin the button's right border is clipped
                        by the panel's content edge and its rounded corner
                        renders flat. Margin="4,2,4,2", as on the others.

                        Find keeps Width="50" although it is inert: ActionButton
                        and Button.action both set MinWidth="100", and both
                        frameworks clamp Width up to MinWidth, so the button
                        renders at 100 in the WPF head too.
                    -->
                    <StackPanel x:Name="RelocationPanelRoot"
                                IsVisible="{Binding IsRelocationPanelVisible}">

                        <TextBlock Classes="panelTitle" Text="Relocation" />

                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF888888"
                                   Margin="0,0,0,4"
                                   Text="Recast a birth chart for a new place: the same moment, with new angles and houses." />

                        <!-- Birth Chart -->
                        <TextBlock Classes="sectionHeader" Text="Birth Chart" />

                        <!--
                            Row 1 names the chart in use, in the field column: the
                            picked chart, else the Chart panel's unsaved one, else
                            none. Each Load and Calculate & Save on the Chart panel
                            picks its chart here.
                        -->
                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Chart" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding AllSavedCharts}"
                                      SelectedItem="{Binding Relocation.SelectedNatalChart}"
                                      DisplayMemberBinding="{Binding Name, x:DataType=data:ChartEntity}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="The birth chart to relocate. Loading or calculating a chart on the Chart panel picks it here."
                                      AutomationProperties.Name="Relocation birth chart" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Relocation.ChartInUseText}"
                                       TextWrapping="Wrap" FontSize="12"
                                       Margin="4,2,0,4"
                                       AutomationProperties.Name="Relocation chart in use" />
                        </Grid>

                        <!-- New Location -->
                        <TextBlock Classes="sectionHeader" Text="New Location" />

                        <Grid ColumnDefinitions="100,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                            <!-- Row 0: Location search -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Search" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Relocation.LocationSearch.SearchText}"
                                     ToolTip.Tip="Enter a city name to search (e.g., London, Tokyo, Sydney)"
                                     AutomationProperties.Name="Relocation location lookup" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="Find"
                                    Command="{Binding LookupRelocationLocationCommand}"
                                    Classes="action"
                                    Width="50"
                                    Margin="4,2,4,2"
                                    AutomationProperties.Name="Find relocation location" />

                            <!-- Row 1: Results dropdown -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Results" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding Relocation.LocationSearch.Results}"
                                      SelectedItem="{Binding Relocation.LocationSearch.SelectedResult}"
                                      IsDropDownOpen="{Binding Relocation.LocationSearch.IsDropDownOpen, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayName, x:DataType=vm:LocationSearchResult}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="Pick a place to fill in its latitude, longitude and name"
                                      AutomationProperties.Name="Relocation location results" />

                            <!-- Row 2: Latitude -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Latitude" />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Relocation.LatitudeText}"
                                     Classes.invalidCoordinate="{Binding !Relocation.IsLatitudeValid}"
                                     ToolTip.Tip="{Binding Relocation.LatitudeToolTip}"
                                     AutomationProperties.Name="Relocation latitude" />

                            <!-- Row 3: Longitude -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="Longitude" />
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Relocation.LongitudeText}"
                                     Classes.invalidCoordinate="{Binding !Relocation.IsLongitudeValid}"
                                     ToolTip.Tip="{Binding Relocation.LongitudeToolTip}"
                                     AutomationProperties.Name="Relocation longitude" />

                            <!-- Row 4: Location name, filled in from Results and editable -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="formLabel" Text="Location" />
                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Relocation.LocationName}"
                                     ToolTip.Tip="Name of the new place (filled in from Results, or typed)"
                                     AutomationProperties.Name="Relocation location name" />
                        </Grid>

                        <!--
                            Three buttons: Calculate, Cancel and Export. Screened
                            at 266.6 px of 350 (76.2%) for Calculate + Cancel,
                            so Export wraps to a second line at narrow widths.
                            The fourth button, which copied the chart's birth
                            place, left the panel in 1.4.0 (branch Relocate):
                            relocating a chart to its own birthplace gives the
                            birth chart back.
                        -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Classes="action export"
                                    Content="Calculate Relocation"
                                    Command="{Binding CalculateRelocationCommand}"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Recast the birth chart for the new place"
                                    AutomationProperties.Name="Calculate Relocation" />
                            <Button Classes="action"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="relocation"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the running relocation calculation"
                                    AutomationProperties.Name="Cancel Relocation" />
                            <Button Classes="action"
                                    Content="Export Relocation MD"
                                    Command="{Binding ExportRelocationMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Export the relocated chart, with its angle and house changes, as Markdown"
                                    AutomationProperties.Name="Export Relocation MD" />
                        </WrapPanel>

                        <!--
                            The result line, shown while a relocation result stands:
                            the chart, the place, the Ascendant's change and the
                            count of house changes. It clears, and Export greys,
                            when the picked chart, the place or the Chart panel's
                            chart changes, until the next Calculate (1.6.1, branch
                            StaleResult).
                        -->
                        <TextBlock Text="{Binding Relocation.ResultSummary}"
                                   IsVisible="{Binding Relocation.HasResult}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Margin="0,2,0,4"
                                   AutomationProperties.Name="Relocation result" />

                    </StackPanel>

                    <!--
                        Primary Directions panel (1.5.0, branch PrimaryPanel), in
                        the Chart panel's section style: a line, one Settings
                        section of four rows on the shared 100 label column,
                        Calculate, Cancel and Export, the result line, and the
                        list, the whole-life report's own table (ListText), in the
                        crossing report's font, unwrapped, scrolling both ways.
                        The key box binds the static AvailableKeys with x:Static,
                        as the Houses box does, and names each key through the
                        DisplayTextConverter. The two number boxes hold what was
                        typed; Calculate Directions greys out while either is
                        outside the engine's limits, and its tooltip says so.
                    -->
                    <StackPanel x:Name="DirectionsPanelRoot"
                                IsVisible="{Binding IsDirectionsPanelVisible}">

                        <TextBlock Classes="panelTitle" Text="Primary Directions" />

                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF888888"
                                   Margin="0,0,0,4"
                                   Text="A dated list of Placidus semi-arc directions, zodiacal, direct and converse, for the chart on the Chart panel." />

                        <!-- Settings -->
                        <TextBlock Classes="sectionHeader" Text="Settings" />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto">

                            <!-- Row 0: the key -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Key" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{x:Static vm:DirectionsViewModel.AvailableKeys}"
                                      SelectedItem="{Binding Directions.Key}"
                                      DisplayMemberBinding="{Binding Converter={StaticResource DisplayTextConverter}, x:DataType=pd:PrimaryDirectionKey}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="The key that turns an arc into years"
                                      AutomationProperties.Name="Primary directions key" />

                            <!-- Row 1: the planets as significators -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Planets" />
                            <CheckBox Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding Directions.PlanetsAsSignificators}"
                                      Content="Add Mercury to Pluto as significators"
                                      Margin="0,4"
                                      ToolTip.Tip="Direct to Mercury through Pluto as well as to the angles, the lights and the Lot"
                                      AutomationProperties.Name="Add Mercury to Pluto as significators" />

                            <!-- Row 2: the age limit -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Age limit" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Classes="formTextBox"
                                         Width="60"
                                         Text="{Binding Directions.AgeLimitYears}"
                                         AutomationProperties.Name="Primary directions age limit" />
                                <TextBlock Text="years, 1 to 120"
                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                           FontSize="11" Foreground="#FF888888" />
                            </StackPanel>

                            <!-- Row 3: the birth-time uncertainty -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="Uncertainty" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Classes="formTextBox"
                                         Width="60"
                                         Text="{Binding Directions.BirthTimeUncertaintyMinutes}"
                                         AutomationProperties.Name="Birth-time uncertainty" />
                                <TextBlock Text="minutes either way, 0 to 120; 0 for none"
                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                           FontSize="11" Foreground="#FF888888"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Classes="action export"
                                    Content="Calculate Directions"
                                    Command="{Binding CalculateDirectionsCommand}"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="List the primary directions of the chart on the Chart panel. Needs a chart there, an age limit of 1 to 120 years and an uncertainty of 0 to 120."
                                    ToolTip.ShowOnDisabled="True"
                                    AutomationProperties.Name="Calculate Directions" />
                            <Button Classes="action"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="directions"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the running primary directions calculation"
                                    AutomationProperties.Name="Cancel Directions" />
                            <Button Classes="action"
                                    Content="Export Directions MD"
                                    Command="{Binding ExportDirectionsMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Export the whole-life Primary Directions Report as Markdown"
                                    AutomationProperties.Name="Export Directions MD" />
                        </WrapPanel>

                        <!-- The result line, shown once directions are calculated -->
                        <TextBlock Text="{Binding Directions.ResultSummary}"
                                   IsVisible="{Binding Directions.HasResult}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Margin="0,2,0,4"
                                   AutomationProperties.Name="Primary directions result" />

                        <!-- The list: the whole-life report's table, as the export writes it -->
                        <TextBox Text="{Binding Directions.ListText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Height="320"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Margin="0,4,0,4"
                                 IsVisible="{Binding Directions.HasResult}"
                                 AutomationProperties.Name="Primary directions list" />

                    </StackPanel>

                    <!--
                        Electional panel. Translated from MainWindow.xaml
                        1802-2061.

                        LABEL COLUMN IS 100, shared with every translated panel;
                        the panels must start their field columns at the same x,
                        and two panels disagreeing is the visible defect slice 2b
                        existed to fix. The value moved 84 -> 100 in slice 5,
                        when the Transits panel brought "Progressions" — the
                        label the global survey said 84 could never hold — into
                        this head. Full derivation at the Chart panel's first
                        form grid.

                        At 100 this panel's widest label, "Mercury Rx", has real
                        slack at last: 75.0 px of macOS ink (1 + 75.0 + 8 = 84.0
                        needed, 16.0 spare) and 72.6 px of Windows advance at
                        the resolved size of 14 (81.6 needed, 18.4 spare). Under
                        the old 84 it fit EXACTLY, to the pixel, and the comment
                        on that row forbade widening it; both comments now
                        record the slack instead.

                        The macOS order is NOT the Windows order: Mercury Rx 75.0
                        > Candidates 74.5 > Natal Chart 73.5, where on Windows
                        "Natal Chart" and "Mercury Rx" are joint-widest and
                        "Candidates" is behind both. Label widths must still be
                        measured on the platform being sized for.

                        NO RESULTS VIEW, deliberately. The WPF panel has none
                        either: a completed search reports through StatusText and
                        the exported Markdown, nothing more. Adding a candidate
                        list here would be new behaviour, not a translation.
                    -->
                    <StackPanel x:Name="ElectionalPanelRoot"
                                IsVisible="{Binding IsElectionalPanelVisible}">
                        <TextBlock Classes="panelTitle" Text="Electional Astrology" />
                        <TextBlock Classes="sectionHeader" Text="Electional" />

                        <Grid ColumnDefinitions="100,*,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                            <!--
                                Row 0: Natal Chart. The field cell holds the
                                picker and, under it, the line naming the chart
                                in use: the picked chart, else the Chart panel's
                                unsaved one, else none. Each Load and Calculate &
                                Save on the Chart panel picks its chart here
                                (1.6.1, branch ElectionalPicker).
                            -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Natal Chart"
                                       VerticalAlignment="Top" Margin="0,6,8,0" />
                            <!--
                                Binds AllSavedCharts, the unfiltered collection,
                                as the Synastry Person B and Relocation natal
                                boxes do (1.4.0, in both heads). Only a refresh
                                refills it, and the refresh keeps the three
                                selections by Id, so a search, a sort or the
                                saved-charts filter does not reach this box, and
                                only deleting its chart empties it. Until 1.4.0
                                the three bound SavedCharts, the filtered list
                                the saved-charts pane binds: the filter narrowed
                                them, and every refill emptied them, because the
                                box wrote null back when the list was cleared.
                            -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                                <ComboBox ItemsSource="{Binding AllSavedCharts}"
                                          SelectedItem="{Binding Electional.SelectedNatalChart}"
                                          DisplayMemberBinding="{Binding Name, x:DataType=data:ChartEntity}"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,2" Padding="4,3"
                                          ToolTip.Tip="The natal chart the search scores against. Loading or calculating a chart on the Chart panel picks it here; with none picked, the Chart panel's chart is used, or else one cast from its fields."
                                          AutomationProperties.Name="Natal chart" />
                                <TextBlock Text="{Binding Electional.ChartInUseText}"
                                           TextWrapping="Wrap" FontSize="12"
                                           Margin="4,2,0,4"
                                           AutomationProperties.Name="Electional chart in use" />
                            </StackPanel>

                            <!-- Row 1: Election Type -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Type" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding Electional.ElectionTypes}"
                                      SelectedItem="{Binding Electional.ElectionType}"
                                      DisplayMemberBinding="{Binding Converter={StaticResource DisplayTextConverter}, x:DataType=enums:ElectionType}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="Category of event (Business Launch, Wedding, etc.)"
                                      AutomationProperties.Name="Election type" />

                            <!-- Row 2: Goal -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Goal"
                                       VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Electional.Goal}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="50"
                                     VerticalContentAlignment="Top"
                                     ToolTip.Tip="Describe the purpose of this election (e.g., Launch new product line)"
                                     AutomationProperties.Name="Goal" />

                            <!-- Row 3: Start Date -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="Start" />
                            <CalendarDatePicker Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                SelectedDate="{Binding Electional.StartDate}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,2" Padding="4,3"
                                                ToolTip.Tip="Earliest acceptable date for the event"
                                                AutomationProperties.Name="Start date" />

                            <!-- Row 4: End Date -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="formLabel" Text="End" />
                            <CalendarDatePicker Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                                SelectedDate="{Binding Electional.EndDate}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,2" Padding="4,3"
                                                ToolTip.Tip="Latest acceptable date for the event"
                                                AutomationProperties.Name="End date" />

                            <!-- Row 5: Location lookup, with Lookup and Use Natal -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Classes="formLabel" Text="Lookup" />
                            <!--
                                Enter triggers the lookup. WPF expresses this as
                                TextBox.InputBindings with KeyBinding Key="Return"
                                — the only per-control input binding in the whole
                                WPF markup. Avalonia's equivalent is
                                TextBox.KeyBindings with Gesture="Enter".
                            -->
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Classes="formTextBox"
                                     Text="{Binding Electional.LocationSearch.SearchText}"
                                     ToolTip.Tip="Enter city name to search (e.g., Richmond, VA)"
                                     AutomationProperties.Name="Electional location lookup">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter"
                                                Command="{Binding LookupElectionalLocationCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal">
                                <!--
                                    Right margin 4 rather than WPF's 2/0, for the
                                    reason documented on the Chart panel's Lookup
                                    button: at the panel's content edge a zero
                                    right margin clips the button's border and
                                    flattens its rounded corner.
                                -->
                                <Button Content="Lookup"
                                        Command="{Binding LookupElectionalLocationCommand}"
                                        Padding="8,3"
                                        Margin="4,2,2,2"
                                        AutomationProperties.Name="Lookup electional location" />
                                <Button Content="Use Natal"
                                        Command="{Binding UseNatalLocationCommand}"
                                        Padding="8,3"
                                        Margin="2,2,4,2"
                                        ToolTip.Tip="Copy location from natal chart"
                                        AutomationProperties.Name="Use natal location" />
                            </StackPanel>

                            <!-- Row 6: Results -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Classes="formLabel" Text="Results" />
                            <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                      ItemsSource="{Binding Electional.LocationSearch.Results}"
                                      SelectedItem="{Binding Electional.LocationSearch.SelectedResult}"
                                      IsDropDownOpen="{Binding Electional.LocationSearch.IsDropDownOpen, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayName, x:DataType=vm:LocationSearchResult}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,2" Padding="4,3"
                                      ToolTip.Tip="Select a result to fill in coordinates and timezone"
                                      AutomationProperties.Name="Electional location results" />

                            <!-- Row 7: Location Name -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Classes="formLabel" Text="Location" />
                            <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Electional.LocationName}"
                                     ToolTip.Tip="City, State/Country for the event"
                                     AutomationProperties.Name="Electional location" />

                            <!-- Row 8: Latitude -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Classes="formLabel" Text="Latitude" />
                            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Electional.LatitudeText}"
                                     ToolTip.Tip="Decimal degrees (positive = North)"
                                     AutomationProperties.Name="Electional latitude" />

                            <!-- Row 9: Longitude -->
                            <TextBlock Grid.Row="9" Grid.Column="0" Classes="formLabel" Text="Longitude" />
                            <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Electional.LongitudeText}"
                                     ToolTip.Tip="Decimal degrees (positive = East)"
                                     AutomationProperties.Name="Electional longitude" />

                            <!-- Row 10: Timezone -->
                            <TextBlock Grid.Row="10" Grid.Column="0" Classes="formLabel" Text="Timezone" />
                            <!--
                                AutoCompleteBox, for the same reason as the Chart
                                panel's timezone field: Avalonia's ComboBox does
                                not survive the Reset that
                                ObservableRangeCollection.ReplaceAll raises, and
                                a two-way Text binding then writes the blanked
                                value back.

                                The WPF SelectedItem binding is dropped, and that
                                loses nothing here. ElectionalViewModel.TimeZone's
                                setter already syncs SelectedTimezone itself, and
                                SelectedTimezone's setter only forwards back to
                                TimeZone; so driving Text alone keeps both in
                                step. FilterMode="None" is mandatory — the
                                default StartsWith would intersect with the view
                                model's Contains filter and hide most matches.

                                Classes.invalidTimezone reuses the class the
                                Chart panel introduced, which already supplies
                                all three of the WPF DataTrigger's setters,
                                tooltip replacement included.
                            -->
                            <AutoCompleteBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"
                                             ItemsSource="{Binding Electional.FilteredTimezones}"
                                             Text="{Binding Electional.TimeZone}"
                                             FilterMode="None"
                                             MinimumPrefixLength="0"
                                             IsTextCompletionEnabled="False"
                                             Classes.invalidTimezone="{Binding !Electional.IsTimezoneValid}"
                                             HorizontalAlignment="Stretch"
                                             Margin="0,2" Padding="4,3"
                                             MaxDropDownHeight="300"
                                             ToolTip.Tip="IANA timezone ID (e.g., America/New_York)"
                                             AutomationProperties.Name="Electional timezone">
                                <!--
                                    The Chart panel's chevron, the same control:
                                    a ToggleButton bound two-way to this box's
                                    IsDropDownOpen, so a click opens the list and
                                    the list closing releases it (O-8, H-01).
                                -->
                                <AutoCompleteBox.InnerRightContent>
                                    <ToggleButton Classes="timezoneChevron"
                                                  IsChecked="{Binding $parent[AutoCompleteBox].IsDropDownOpen, Mode=TwoWay}"
                                                  ToolTip.Tip="Show the time-zone list"
                                                  AutomationProperties.Name="Show electional time zones">
                                        <PathIcon Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z"
                                                  Width="12"
                                                  Height="12"
                                                  Margin="0,0,9,0"
                                                  Foreground="{DynamicResource ComboBoxDropDownGlyphForeground}" />
                                    </ToggleButton>
                                </AutoCompleteBox.InnerRightContent>
                            </AutoCompleteBox>

                            <!-- Row 11: Candidates -->
                            <TextBlock Grid.Row="11" Grid.Column="0" Classes="formLabel" Text="Candidates" />
                            <TextBox Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Electional.CandidateCount}"
                                     ToolTip.Tip="Number of candidate windows to return (1-5)"
                                     AutomationProperties.Name="Candidate count" />

                            <!-- Row 12: Earliest Time -->
                            <TextBlock Grid.Row="12" Grid.Column="0" Classes="formLabel" Text="Earliest" />
                            <TextBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Electional.EarliestTimeText}"
                                     ToolTip.Tip="Earliest acceptable local time in HH:mm format (e.g., 09:00). Leave empty for any time. Together with Latest this limits candidates to local times within the window."
                                     AutomationProperties.Name="Earliest time" />

                            <!-- Row 13: Latest Time -->
                            <TextBlock Grid.Row="13" Grid.Column="0" Classes="formLabel" Text="Latest" />
                            <TextBox Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Electional.LatestTimeText}"
                                     ToolTip.Tip="Latest acceptable local time in HH:mm format (e.g., 17:00). Leave empty for any time. Together with Earliest this limits candidates to local times within the window."
                                     AutomationProperties.Name="Latest time" />

                            <!-- Row 14: Allowed Days -->
                            <TextBlock Grid.Row="14" Grid.Column="0" Classes="formLabel" Text="Days"
                                       VerticalAlignment="Top" Margin="0,6,8,0"
                                       ToolTip.Tip="Allowed days: candidates are limited to the checked days of the week" />
                            <!--
                                The wrap here is settled measurement, not the
                                screen that shipped with slice 4. That screen
                                compared ink against the column width, and its
                                figures — 240 px of a 261 px column, 91.9% —
                                are superseded. By layout extent the five
                                weekday boxes need 249 px in the WPF head
                                against 245 available at the shipped window
                                size (the vertical scrollbar costs 17), so WPF
                                wraps 4+3 there and 5+2 only in a window tall
                                enough to retract the scrollbar. This head
                                needs 301 against 258 and wraps 4+3 at every
                                size, its scrollbar never retracting. The two
                                heads therefore agree at the default size.
                                Full derivation: MACOS_PORT_PLAN.md,
                                "Measurement reconciliation (2026-08-08)".
                            -->
                            <WrapPanel Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2"
                                       Orientation="Horizontal"
                                       Margin="0,4">
                                <CheckBox Content="Mon" IsChecked="{Binding Electional.AllowMonday}" Margin="0,0,8,2"
                                          ToolTip.Tip="Allow candidates on Mondays"
                                          AutomationProperties.Name="Allow Monday" />
                                <CheckBox Content="Tue" IsChecked="{Binding Electional.AllowTuesday}" Margin="0,0,8,2"
                                          ToolTip.Tip="Allow candidates on Tuesdays"
                                          AutomationProperties.Name="Allow Tuesday" />
                                <CheckBox Content="Wed" IsChecked="{Binding Electional.AllowWednesday}" Margin="0,0,8,2"
                                          ToolTip.Tip="Allow candidates on Wednesdays"
                                          AutomationProperties.Name="Allow Wednesday" />
                                <CheckBox Content="Thu" IsChecked="{Binding Electional.AllowThursday}" Margin="0,0,8,2"
                                          ToolTip.Tip="Allow candidates on Thursdays"
                                          AutomationProperties.Name="Allow Thursday" />
                                <CheckBox Content="Fri" IsChecked="{Binding Electional.AllowFriday}" Margin="0,0,8,2"
                                          ToolTip.Tip="Allow candidates on Fridays"
                                          AutomationProperties.Name="Allow Friday" />
                                <CheckBox Content="Sat" IsChecked="{Binding Electional.AllowSaturday}" Margin="0,0,8,2"
                                          ToolTip.Tip="Allow candidates on Saturdays"
                                          AutomationProperties.Name="Allow Saturday" />
                                <CheckBox Content="Sun" IsChecked="{Binding Electional.AllowSunday}" Margin="0,0,8,2"
                                          ToolTip.Tip="Allow candidates on Sundays"
                                          AutomationProperties.Name="Allow Sunday" />
                            </WrapPanel>

                            <!--
                                Row 15: Mercury Retrograde.

                                "Mercury Rx" is the widest label in this panel.
                                Under the old 84 px column it fit EXACTLY — 75.0
                                px of macOS ink + 1 bearing + 8 margin = 84.0 in
                                an 84.0 column, ink right edge one device pixel
                                from the clip boundary — and this comment
                                forbade widening it. At the shared 100 it has
                                16.0 px of slack on macOS and 18.4 on Windows
                                (72.6 px advance at the resolved 14), so a
                                rename now has room; anything longer than
                                "Candidates" still wants a macOS measurement
                                first.
                            -->
                            <TextBlock Grid.Row="15" Grid.Column="0" Classes="formLabel" Text="Mercury Rx" />
                            <CheckBox Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2"
                                      IsChecked="{Binding Electional.AvoidMercuryRetrograde}"
                                      Content="Avoid Mercury retrograde"
                                      Margin="0,4"
                                      ToolTip.Tip="Exclude dates when Mercury is retrograde"
                                      AutomationProperties.Name="Avoid Mercury retrograde" />

                            <!-- Row 16: Constraint Notes -->
                            <TextBlock Grid.Row="16" Grid.Column="0" Classes="formLabel" Text="Notes"
                                       VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2"
                                     Classes="formTextBox"
                                     Text="{Binding Electional.ConstraintNotes}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="50"
                                     VerticalContentAlignment="Top"
                                     ToolTip.Tip="Additional constraints or notes for the election"
                                     AutomationProperties.Name="Constraint notes" />
                        </Grid>

                        <!--
                            Screened: row 1 uses 246 px of 342 px (71.9%), well
                            under the ~94% line, and the break after Cancel is
                            expected to match WPF.

                            CommandParameter="electional" is load-bearing and is
                            pinned by a test, exactly as Cancel PDF's "pdfSave"
                            is. CancelCommand's CanExecute is
                            CanCancel(parameter as string), which returns
                            HasActiveOperation when the key is null or blank —
                            so a missing or misspelled value does not fail the
                            build, it silently makes this button track any
                            running operation instead of the electional search.
                        -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Classes="action export"
                                    Content="Calculate Electional"
                                    Command="{Binding CalculateElectionalCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Calculate Electional" />
                            <Button Classes="action"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="electional"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Electional search"
                                    AutomationProperties.Name="Cancel Electional" />
                            <Button Classes="action"
                                    Content="Export Electional MD"
                                    Command="{Binding ExportElectionalMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Electional MD" />
                        </WrapPanel>

                    </StackPanel>

                    <!--
                        Medical Astrology. Translated from MainWindow.xaml
                        2063-2100. Seven elements in the WPF order, same text,
                        same two interactive controls. The panel title really
                        does appear twice in the original — once as the
                        panelTitle, once again as a sectionHeader immediately
                        below — and that is reproduced rather than tidied.

                        THE ONE LABEL IS STACKED, NOT COLUMNED. "Health Context
                        (optional)" is this panel's only formLabel, and the WPF
                        original puts it on its own line above the box instead
                        of in a form grid. That is load-bearing, not incidental:
                        the label measures 161.4 px of ink at this head's 14 DIP
                        (150.1 advance at the WPF head's 13), so a cell would
                        need about 170 and the shared 100 column would clip it
                        by seventy. This panel therefore contributes no form
                        grid at all, and LabelColumnAlignmentTests registers it
                        with an expected count of zero so that wrapping this
                        label in a form grid later fails loudly instead of
                        quietly truncating it.

                        Two WPF attributes are deliberately absent. Both were
                        checked against Avalonia 12.1.0 rather than assumed:

                          UpdateSourceTrigger=PropertyChanged
                              Avalonia's TextBox already writes its binding on
                              every keystroke; there is no such trigger to set.
                              Same treatment as the Electional notes box.

                          VerticalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility already
                              defaults to Auto on TextBox here (horizontal to
                              Disabled), so restating it would be noise.
                              TextWrapping is NOT in that category — it defaults
                              to NoWrap — so it is carried over explicitly.

                        The box takes no formTextBox class because the WPF box
                        takes no FormTextBox style. Its VerticalContentAlignment
                        default of Stretch already tops the text in a 100 px
                        multi-line box, so nothing needs restoring there either.

                        Enablement is not expressed here and must not be: the
                        only gate is the CanExecute predicate supplied to
                        ExportMedicalMarkdownCommand in MainViewModel's
                        constructor (_ => HasResult), which Avalonia re-queries
                        exactly as WPF does. The WPF markup carries no IsEnabled
                        either.

                        Note for whoever next touches the health-context box:
                        MedicalHealthContext is bound here faithfully, but as of
                        this slice nothing reads it. The export path runs
                        HealthProfileGenerator.Generate(ChartResult) and
                        MedicalMarkdownFormatter.Format(ChartResult,
                        HealthProfile, TimeProvider?), and neither signature
                        takes a health context — so the text never reaches the
                        report the paragraph below promises it reaches. That is
                        pre-existing WPF behaviour, reproduced deliberately;
                        changing it is a Presentation change, not a port change.
                    -->
                    <StackPanel x:Name="MedicalPanelRoot"
                                IsVisible="{Binding IsMedicalPanelVisible}">

                        <TextBlock Classes="panelTitle" Text="Medical Astrology" />

                        <TextBlock Classes="sectionHeader" Text="Medical Astrology" />

                        <!-- Health Context input -->
                        <TextBlock Classes="formLabel"
                                   Text="Health Context (optional)"
                                   Margin="0,12,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF555555"
                                   Margin="0,0,0,6"
                                   Text="Describe any known conditions, symptoms, or health history. This text is included verbatim in the exported report header for AI-assisted interpretation." />
                        <TextBox Text="{Binding MedicalHealthContext}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="100"
                                 Margin="0,0,0,12"
                                 FontSize="12"
                                 AutomationProperties.Name="Health context" />

                        <!--
                            Export button. HorizontalAlignment="Stretch" is
                            restoring a WPF default, not adding a choice: a WPF
                            Button in a vertical StackPanel fills the panel, and
                            this one renders 342 px wide there. Avalonia's
                            Layoutable default is Stretch too, but FluentTheme's
                            Button style overrides it, so the untouched button
                            auto-sized to 242 px and sat left — measured, before
                            and after, at 950x600 with UI Automation. Same class
                            of fix as the CalendarDatePicker stretch established
                            in slices 2-4. The other action buttons in this head
                            live in WrapPanels, which auto-size in both
                            frameworks, which is why this is the first place the
                            difference could show.
                        -->
                        <Button Classes="action"
                                Content="Export Medical Report (Markdown)"
                                Command="{Binding ExportMedicalMarkdownCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                ToolTip.Tip="Generate a medical astrology report for the current natal chart and save it as a Markdown file."
                                AutomationProperties.Name="Export Medical Report (Markdown)" />

                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF888888"
                                   Margin="0,4,0,0"
                                   Text="Report includes: the natal chart, Temperament Assessment, Zodiacal Anatomy, Planetary Body Correspondences, Hard Aspects (medical significance) and Health Houses (6th, 8th, 12th)." />
                    </StackPanel>

                    <!--
                        ═══ MAP PANEL (ASTROCARTOGRAPHY) ═══
                        Translated from MainWindow.xaml lines 1719-1799 of the
                        WPF head. Same header, same three action buttons, same
                        twelve planet toggles in the same order and colours, same
                        four line-type toggles, same crossing-report box.

                        The map itself is NOT here. It lives in a separate
                        floating window (AcgMapWindow) so it can use the whole
                        screen instead of this 334 px panel column, exactly as in
                        the WPF head; this panel is the control surface for it.

                        Two translations are not mechanical.

                        1. Every Visibility binding through BoolToVisConverter
                           becomes a direct IsVisible bool binding. Five controls
                           here are gated on Astrocartography.HasResult, so the
                           panel is a header and three buttons until a chart has
                           been calculated.

                        2. The crossing-report TextBox keeps WPF's attributes
                           verbatim, including the absence of AcceptsReturn.
                           Avalonia and WPF do not agree on whether a TextBox
                           without AcceptsReturn renders embedded newlines, and
                           the report is multi-line, so this one is verified on
                           glass rather than reasoned about.
                    -->
                    <StackPanel x:Name="MapPanelRoot"
                                IsVisible="{Binding IsMapPanelVisible}">

                        <TextBlock Classes="panelTitle" Text="Astrocartography" />

                        <WrapPanel Margin="0,4,0,4">
                            <Button Content="Calculate ACG Map"
                                    Command="{Binding CalculateAcgCommand}"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Compute astrocartography lines for the natal chart" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="astrocartography"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the active Astrocartography calculation"
                                    AutomationProperties.Name="Cancel Astrocartography" />
                            <Button Content="Export ACG MD"
                                    Command="{Binding ExportAcgMarkdownCommand}"
                                    Classes="action"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Export astrocartography data as Markdown" />
                        </WrapPanel>

                        <!-- Map opens in a separate floating window so it can use
                             the full screen instead of being squeezed by the sidebar. -->
                        <Button Content="Open Map Window"
                                Command="{Binding OpenAcgMapWindowCommand}"
                                Classes="action"
                                Margin="0,4,0,4"
                                FontSize="12"
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="Open the astrocartography map in a separate resizable window"
                                IsVisible="{Binding Astrocartography.HasResult}" />

                        <!-- Planet Toggles -->
                        <TextBlock Text="Planets:" FontWeight="Bold" FontSize="10" Margin="0,4,0,2"
                                   IsVisible="{Binding Astrocartography.HasResult}" />
                        <WrapPanel Margin="0,0,0,4"
                                   IsVisible="{Binding Astrocartography.HasResult}">
                            <CheckBox Content="Sun" IsChecked="{Binding Astrocartography.ShowSun}" Margin="0,0,8,0" Foreground="#FFD700" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Moon" IsChecked="{Binding Astrocartography.ShowMoon}" Margin="0,0,8,0" Foreground="#C0C0C0" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Mercury" IsChecked="{Binding Astrocartography.ShowMercury}" Margin="0,0,8,0" Foreground="#FF8C00" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Venus" IsChecked="{Binding Astrocartography.ShowVenus}" Margin="0,0,8,0" Foreground="#32CD32" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Mars" IsChecked="{Binding Astrocartography.ShowMars}" Margin="0,0,8,0" Foreground="#DC143C" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Jupiter" IsChecked="{Binding Astrocartography.ShowJupiter}" Margin="0,0,8,0" Foreground="#8A2BE2" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Saturn" IsChecked="{Binding Astrocartography.ShowSaturn}" Margin="0,0,8,0" Foreground="#00008B" FontWeight="Bold" FontSize="10" />
                            <CheckBox Content="Uranus" IsChecked="{Binding Astrocartography.ShowUranus}" Margin="0,0,8,0" Foreground="#00CED1" FontSize="10" />
                            <CheckBox Content="Neptune" IsChecked="{Binding Astrocartography.ShowNeptune}" Margin="0,0,8,0" Foreground="#008080" FontSize="10" />
                            <CheckBox Content="Pluto" IsChecked="{Binding Astrocartography.ShowPluto}" Margin="0,0,8,0" Foreground="#8B0000" FontSize="10" />
                            <CheckBox Content="Chiron" IsChecked="{Binding Astrocartography.ShowChiron}" Margin="0,0,8,0" Foreground="#8B4513" FontSize="10" />
                            <CheckBox Content="Node" IsChecked="{Binding Astrocartography.ShowNorthNode}" Margin="0,0,8,0" Foreground="#696969" FontSize="10" />
                        </WrapPanel>

                        <!-- Line Type Toggles -->
                        <WrapPanel Margin="0,0,0,4"
                                   IsVisible="{Binding Astrocartography.HasResult}">
                            <TextBlock Text="Lines:" FontWeight="Bold" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <CheckBox Content="MC" IsChecked="{Binding Astrocartography.ShowMcLines}" Margin="0,0,8,0" FontSize="10" />
                            <CheckBox Content="IC" IsChecked="{Binding Astrocartography.ShowIcLines}" Margin="0,0,8,0" FontSize="10" />
                            <CheckBox Content="ASC" IsChecked="{Binding Astrocartography.ShowAscLines}" Margin="0,0,8,0" FontSize="10" />
                            <CheckBox Content="DSC" IsChecked="{Binding Astrocartography.ShowDscLines}" Margin="0,0,8,0" FontSize="10" />
                        </WrapPanel>

                        <!-- Crossing Report -->
                        <TextBox Text="{Binding Astrocartography.CrossingReportText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="9"
                                 Height="80"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,4"
                                 IsVisible="{Binding Astrocartography.HasResult}" />

                    </StackPanel>

                    <!--
                        Export &amp; Backup. Translated from MainWindow.xaml
                        2103-2233. Seven groups in the WPF order, same labels,
                        same nineteen buttons.

                        Enablement is not expressed here and must not be: every
                        gate is the CanExecute predicate supplied to the command
                        in MainViewModel's constructor (ExportPdfCommand takes
                        _ => HasResult, and so on), and Avalonia re-queries
                        ICommand.CanExecute exactly as WPF does. The WPF markup
                        carries no IsEnabled either. Export Backup and Import Backup
                        are the only two commands with no predicate, so they are
                        the only buttons enabled before a chart is calculated —
                        which is what makes importing into an empty database
                        reachable at all.

                        Every button carries ActionButton in WPF, which is
                        Classes="action" here. None carries the ExportButton
                        style, so none takes Classes="export".
                    -->
                    <StackPanel x:Name="ExportPanelRoot"
                                IsVisible="{Binding IsExportPanelVisible}">
                        <TextBlock Classes="panelTitle" Text="Export &amp; Backup" />

                        <!-- Chart Exports -->
                        <TextBlock Classes="exportGroup" Text="Chart Export" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Classes="action"
                                    Content="Export PDF"
                                    Command="{Binding ExportPdfCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export PDF" />
                            <Button Classes="action"
                                    Content="Export Markdown"
                                    Command="{Binding ExportMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Markdown" />
                            <Button Classes="action"
                                    Content="Export JSON"
                                    Command="{Binding ExportChartJsonCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export JSON" />
                            <Button Classes="action"
                                    Content="Export Both"
                                    Command="{Binding ExportBothCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Both" />
                            <!--
                                The CommandParameter is the registry key, and it
                                is load-bearing: CancelCommand's CanExecute is
                                CanCancel(param as string), which returns
                                _cancelRegistry.IsOperationActive("pdfSave").
                                A missing or misspelled parameter does not fail
                                the build — it silently makes the button test
                                HasActiveOperation instead, so it would enable
                                during any operation rather than the PDF export.
                            -->
                            <Button Classes="action"
                                    Content="Cancel PDF"
                                    Command="{Binding CancelCommand}"
                                    CommandParameter="pdfSave"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Cancel the running PDF export"
                                    AutomationProperties.Name="Cancel PDF" />
                        </WrapPanel>

                        <!-- Synastry/Composite/Davison Exports (the third since branch DavisonPanel, 1.7.0) -->
                        <TextBlock Classes="exportGroup" Text="Synastry, Composite &amp; Davison" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Classes="action"
                                    Content="Export Synastry MD"
                                    Command="{Binding ExportSynastryMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Synastry MD" />
                            <Button Classes="action"
                                    Content="Export Composite MD"
                                    Command="{Binding ExportCompositeMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Composite MD" />
                            <Button Classes="action"
                                    Content="Export Davison MD"
                                    Command="{Binding ExportDavisonMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Davison MD" />
                        </WrapPanel>

                        <!-- Transit Export -->
                        <TextBlock Classes="exportGroup" Text="Transits" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Classes="action"
                                    Content="Export Report MD"
                                    Command="{Binding ExportTransitMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Report MD" />
                            <Button Classes="action"
                                    Content="Export Timeline MD"
                                    Command="{Binding ExportTransitTimelineMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Timeline MD" />
                        </WrapPanel>

                        <!-- Primary Directions Export (1.5.0, branch PrimaryPanel) -->
                        <TextBlock Classes="exportGroup" Text="Primary Directions" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Classes="action"
                                    Content="Export Directions MD"
                                    Command="{Binding ExportDirectionsMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Directions MD" />
                        </WrapPanel>

                        <!-- Daily Horoscope Export -->
                        <TextBlock Classes="exportGroup" Text="Daily Horoscope" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Classes="action"
                                    Content="Export Daily Horoscope MD"
                                    Command="{Binding ExportDailyHoroscopeMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Daily Horoscope MD" />
                            <Button Classes="action"
                                    Content="Export RI Timeline MD"
                                    Command="{Binding ExportRITimelineCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export RI Timeline MD" />
                        </WrapPanel>

                        <!-- Return Exports -->
                        <TextBlock Classes="exportGroup" Text="Returns" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Classes="action"
                                    Content="Export Solar Return MD"
                                    Command="{Binding ExportSolarReturnMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Solar Return MD" />
                            <Button Classes="action"
                                    Content="Export Lunar Return MD"
                                    Command="{Binding ExportLunarReturnMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Lunar Return MD" />
                            <Button Classes="action"
                                    Content="Export Planetary Return MD"
                                    Command="{Binding ExportPlanetaryReturnMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Planetary Return MD" />
                            <Button Classes="action"
                                    Content="Export Cycle Timeline MD"
                                    Command="{Binding ExportCycleTimelineMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Cycle Timeline MD" />
                            <Button Classes="action"
                                    Content="Export GC Series MD"
                                    Command="{Binding ExportGCSeriesMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export GC Series MD" />
                        </WrapPanel>

                        <!-- Electional Export -->
                        <TextBlock Classes="exportGroup" Text="Electional" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Classes="action"
                                    Content="Export Electional MD"
                                    Command="{Binding ExportElectionalMarkdownCommand}"
                                    Margin="0,2,6,2"
                                    AutomationProperties.Name="Export Electional MD" />
                        </WrapPanel>

                        <!-- Database Backup -->
                        <TextBlock Classes="exportGroup" Text="Database Backup" Margin="0,8,0,4" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Classes="action"
                                    Content="Export Backup"
                                    Command="{Binding ExportDatabaseCommand}"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Export all charts to a JSON file for backup or transfer"
                                    AutomationProperties.Name="Export Backup" />
                            <Button Classes="action"
                                    Content="Import Backup"
                                    Command="{Binding ImportDatabaseCommand}"
                                    Margin="0,2,6,2"
                                    ToolTip.Tip="Import charts from a JSON file (updates existing, adds new)"
                                    AutomationProperties.Name="Import Backup" />
                        </WrapPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="2"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#FFCCCCCC" />

            <!--
                Saved-charts pane. Always visible in the WPF head — it is chrome
                rather than one of the ten panels. Translated from
                MainWindow.xaml 2244-2403.

                SELECTION DOES NOTHING, DELIBERATELY. The WPF ListView sets
                SelectionMode="Single" but binds no SelectedItem, has no
                SelectionChanged, and its code-behind has no handler; a chart is
                loaded only by the per-item Load button. That is reproduced
                exactly. Adding select-to-load here would be new behaviour, not a
                translation, and would diverge the two heads.

                ListBox, not ListView: Avalonia has no ListView.
            -->
            <DockPanel x:Name="SavedChartsPane"
                       Grid.Column="3" Margin="8,0,0,0">

                <TextBlock DockPanel.Dock="Top"
                           Classes="sectionHeader"
                           Text="Saved Charts" />

                <!-- Search Bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6"
                      ColumnDefinitions="*,Auto">
                    <!--
                        UpdateSourceTrigger=PropertyChanged is carried over from
                        the WPF markup for fidelity, but it is REDUNDANT here —
                        it changes nothing on Avalonia 12.1.0.

                        An earlier version of this comment claimed the opposite:
                        that Avalonia's TextBox.Text commits on LostFocus by
                        default, so that omitting the attribute would leave
                        SearchText holding the previous term, and cited a
                        macOS measurement to that effect. That is wrong, and the
                        measurement does not reproduce. Two independent checks
                        during slice 3's test pass:

                          - Deleting the attribute from this very binding and
                            re-running the search-box test changed nothing; the
                            view model still received each keystroke.
                          - A side-by-side headless probe bound two TextBoxes to
                            two properties, one with the attribute and one
                            without, and typed into each while it held focus.
                            Both view-model properties updated immediately:
                            "WITH attr, still focused: vm='Ada'" and
                            "WITHOUT, still focused: vm='Bob'".

                        Avalonia commits per keystroke by default, so the WPF
                        default (LostFocus) is the one that needed the explicit
                        attribute, not this one.

                        CONSEQUENCE FOR SCOPE: the WPF markup carries this
                        attribute on 50 two-way TextBox bindings and this head
                        currently has one. That difference is NOT a defect and
                        needs no follow-up slice — the previous comment implied
                        49 sites of remedial work that do not exist. The
                        attribute is kept here only because it mirrors the source
                        markup and would become meaningful if Avalonia's default
                        ever changed.
                    -->
                    <TextBox Grid.Column="0"
                             Classes="formTextBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip.Tip="Search by name"
                             AutomationProperties.Name="Search charts by name" />
                    <Button Grid.Column="1"
                            Classes="action"
                            Content="Search"
                            Command="{Binding SearchChartsCommand}"
                            Margin="6,2,0,2"
                            AutomationProperties.Name="Search" />
                </Grid>

                <!-- Filter Controls -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6"
                      ColumnDefinitions="Auto,*,Auto,*"
                      RowDefinitions="Auto,Auto">

                    <!-- Row 0: Event Type + Sort -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Classes="formLabel" Text="Type" Margin="0,0,4,0" />
                    <!--
                        SelectedValuePath / DisplayMemberPath become
                        SelectedValueBinding / DisplayMemberBinding, each needing
                        an explicit x:DataType because the item type differs from
                        the window's. Identical to the Type combo already shipped
                        in the Chart panel, over the same EventTypeDisplayItem.
                    -->
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding EventTypeFilterOptions}"
                              SelectedValueBinding="{Binding Value, x:DataType=enums:EventTypeDisplayItem}"
                              DisplayMemberBinding="{Binding DisplayName, x:DataType=enums:EventTypeDisplayItem}"
                              SelectedValue="{Binding FilterEventType}"
                              HorizontalAlignment="Stretch"
                              Margin="0,2" Padding="4,3"
                              ToolTip.Tip="Filter by event type (All = no filter)"
                              AutomationProperties.Name="Filter by event type" />

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Classes="formLabel" Text="Sort" Margin="8,0,4,0" />
                    <StackPanel Grid.Row="0" Grid.Column="3"
                                Orientation="Horizontal" Margin="0,2">
                        <ComboBox ItemsSource="{Binding SortFieldValues}"
                                  SelectedItem="{Binding SortField}"
                                  DisplayMemberBinding="{Binding Converter={StaticResource DisplayTextConverter}, x:DataType=enums:ChartSortField}"
                                  MinWidth="80" Padding="4,3"
                                  ToolTip.Tip="Sort field"
                                  AutomationProperties.Name="Sort field" />
                        <Button Classes="sortDirection"
                                Classes.descending="{Binding !SortAscending}"
                                Command="{Binding ToggleSortDirectionCommand}"
                                Padding="6,3" Margin="4,0,0,0"
                                ToolTip.Tip="Toggle sort direction"
                                AutomationProperties.Name="Toggle sort direction" />
                    </StackPanel>

                    <!-- Row 1: Date Range -->
                    <!--
                        CalendarDatePicker, not DatePicker — the same choice
                        slice 1 made for the chart-entry date. Avalonia's
                        DatePicker is the WinUI three-column spinner and its
                        SelectedDate is DateTimeOffset?, which would not bind to
                        FilterDateFrom/FilterDateTo (DateTime?) at all.
                    -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Classes="formLabel" Text="From" Margin="0,0,4,0" />
                    <CalendarDatePicker Grid.Row="1" Grid.Column="1"
                                        SelectedDate="{Binding FilterDateFrom}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,2" Padding="4,3"
                                        ToolTip.Tip="Filter charts from this date"
                                        AutomationProperties.Name="Filter from date" />

                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Classes="formLabel" Text="To" Margin="8,0,4,0" />
                    <CalendarDatePicker Grid.Row="1" Grid.Column="3"
                                        SelectedDate="{Binding FilterDateTo}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,2" Padding="4,3"
                                        ToolTip.Tip="Filter charts up to this date"
                                        AutomationProperties.Name="Filter to date" />
                </Grid>

                <!-- Charts list -->
                <ListBox ItemsSource="{Binding SavedCharts}"
                         SelectionMode="Single"
                         HorizontalAlignment="Stretch"
                         AutomationProperties.Name="Saved charts">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="data:ChartEntity">
                            <Border BorderBrush="#FFDDDDDD"
                                    BorderThickness="0,0,0,1"
                                    Padding="4,6">
                                <Grid ColumnDefinitions="*,Auto">

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <!--
                                            The type by name, the place and the
                                            reading as typed (1.4.0, E3-6):
                                            DisplayText.SavedChartDetail.
                                        -->
                                        <TextBlock FontSize="11" Foreground="#FF666666"
                                                   Text="{Binding Converter={StaticResource DisplayTextConverter}}" />
                                        <!--
                                            WPF hides this with two DataTriggers,
                                            one for {x:Null} and one for "".
                                            Avalonia's built-in
                                            StringConverters.IsNotNullOrEmpty
                                            covers both in a single binding.
                                        -->
                                        <TextBlock Text="{Binding Keywords}"
                                                   FontSize="10"
                                                   Foreground="#FF999999"
                                                   FontStyle="Italic"
                                                   IsVisible="{Binding Keywords,
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <!--
                                        The commands live on MainViewModel, not on
                                        the item. WPF reaches them with
                                        RelativeSource AncestorType=ListView;
                                        Avalonia uses $parent[ListBox], and the
                                        DataContext needs an explicit cast because
                                        compiled bindings cannot infer it.
                                    -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Load"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).LoadChartCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3"
                                                Margin="4,0"
                                                AutomationProperties.Name="Load chart" />
                                        <Button Content="Delete"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteChartCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3"
                                                Margin="4,0"
                                                Foreground="#FFD9534F"
                                                AutomationProperties.Name="Delete chart" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>

        </Grid>
    </DockPanel>
</Window>
